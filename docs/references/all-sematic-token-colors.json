{
  "$schema": "vscode://schemas/color-theme",
  "name": "Cassidy Dark",
  "type": "dark",
  "description": "All parent-level sematic token properties",
  "author": "Jacob Cassidy",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "*.abstract": "#f0f",
    "*.async": "#f0f",
    "*.builtin": "#f0f",
    "*.callable": "#f0f",
    "*.classMember": "#f0f",
    "*.declaration": "#f0f",
    "*.decorator": "#f0f",
    "*.deprecated": "#f0f",
    "*.documentation": "#f0f",
    "*.escapeCharacter": "#f0f",
    "*.invalid": "#f0f",
    "*.keywordArgument": "#f0f",
    "*.modification": "#f0f",
    "*.overridden": "#f0f",
    "*.readonly": "#f0f",
    "*.static": "#f0f",
    "*.typeHint": "#f0f",
    "*.typeHintComment": "#f0f",
    "arrow": "#f0f",
    "bracket": "#f0f",
    "builtinConstant": "#f0f",
    "class": "#f0f",
    "clsParameter": "#f0f",
    "colon": "#f0f",
    "comment": "#f0f",
    "curlybrace": "#f0f",
    "decorator": "#f0f",
    "defaultLibrary": "#f0f",
    "enum": "#f0f",
    "enumMember": "#f0f",
    "event": "#f0f",
    "function": "#f0f",
    "interface": "#f0f",
    "intrinsic": "#f0f",
    "keyword": "#f0f",
    "label": "#f0f",
    "macro": "#f0f",
    "magicFunction": "#f0f",
    "method": "#f0f",
    "module": "#f0f",
    "namespace": "#f0f",
    "number": "#f0f",
    "operator": "#f0f",
    "parameter": "#f0f",
    // "parameter.declaration": "#0f0",
    // "parameter.definition": "#f0f",
    // "parameter.readonly": "#00f",
    // "parameter.static": "#ff0",
    // "parameter.deprecated": "#f0f",
    // "parameter.abstract": "#0ff",
    // "parameter.async": "#99f",
    // "parameter.modification": "#0f0",
    // "parameter.documentation": "#9f9",
    // "parameter.defaultLibrary": "#00f",
    // "parameter.readwrite": "#ff0",
    "parenthesis": "#f0f",
    "property": "#f0f",
    "regexp": "#f0f",
    "selfParameter": "#f0f",
    "semicolon": "#f0f",
    "string": "#f0f",
    "struct": "#f0f",
    "type": "#f0f",
    "typeParameter": "#f0f",
    "variable": "#f0f"
    // "variable.declaration": "#0f0",
    // "variable.definition": "#f0f",
    // "variable.readonly": "#9f9",
    // "variable.static": "#ff0",
    // "variable.deprecated": "#f0f",
    // "variable.abstract": "#0ff",
    // "variable.async": "#99f",
    // "variable.modification": "#f99",
    // "variable.documentation": "#9f9",
    // "variable.defaultLibrary": "#09f",
  }
}
