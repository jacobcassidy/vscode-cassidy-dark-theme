// Complete authored UI definitions; aliases resolve in the owning theme.
{
  "standard": {
    "editor": {
      "background": {
        "color": "variables.surface.editor"
      }
    },
    "testing": {
      "iconFailed": {
        "color": "variables.diagnostic.error.foreground",
        "retired": {
          "color": "variables.diagnostic.error.foreground",
          "alpha": 0.5
        }
      }
    }
  },
  "sourceCode": {},
  "nonStandard": {
    "exampleExtension": {
      "foreground": {
        "disabled": true,
        "disabledReason": "Illustrative custom token; review its contributor before enabling."
      }
    }
  },
  "deprecated": {}
}
