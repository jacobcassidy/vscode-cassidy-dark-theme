// Complete authored semantic definitions; modifiers and language qualifiers remain exact.
{
  "standard": {
    "parameter": {
      "default": {
        "color": "syntax.parameter"
      }
    },
    "function": {
      "defaultLibrary": {
        "color": "syntax.function",
        "italic": false
      }
    }
  },
  "sourceCode": {},
  "nonStandard": {
    "*": {
      "builtin.deprecated": {
        "bold": true
      }
    },
    "variable:typescript": {
      "default": {
        "color": "syntax.string"
      },
      "readonly": {
        "color": "syntax.string",
        "italic": true
      }
    },
    "parameter": {
      "readwrite": {
        "color": "syntax.parameter"
      }
    }
  },
  "deprecated": {}
}
