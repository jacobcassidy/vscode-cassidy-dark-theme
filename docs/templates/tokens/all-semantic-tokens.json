{
  "$schema": "vscode://schemas/color-theme",
  "name": "Semantic Tokens",
  "for": "Scripts generating src/themes/*/tokens/semantic.jsonc files",
  "semanticTokenColors": {
    // -- STANDARD --
    "*.abstract": "#000",
    "*.async": "#000",
    "*.builtin": "#000",
    "*.callable": "#000",
    "*.classMember": "#000",
    "*.declaration": "#000",
    "*.decorator": "#000",
    "*.deprecated": "#000",
    "*.documentation": "#000",
    "*.escapeCharacter": "#000",
    "*.invalid": "#000",
    "*.keywordArgument": "#000",
    "*.library": "#000",
    "*.modification": "#000",
    "*.overridden": "#000",
    "*.readonly": "#000",
    "*.static": "#000",
    "*.typeHint": "#000",
    "*.typeHintComment": "#000",
    "arrow": "#000",
    "bracket": "#000",
    "builtinConstant": "#000",
    "class": "#000",
    "clsParameter": "#000",
    "colon": "#000",
    "comment": "#000",
    "curlybrace": "#000",
    "decorator": "#000",
    "enum": "#000",
    "enumMember": "#000",
    "event": "#000",
    "function": "#000",
    "interface": "#000",
    "intrinsic": "#000",
    "keyword": "#000",
    "label": "#000",
    "macro": "#000",
    "magicFunction": "#000",
    "method": "#000",
    "module": "#000",
    "namespace": "#000",
    "number": "#000",
    "operator": "#000",
    "parameter": "#000",
    "parenthesis": "#000",
    "property": "#000",
    "regexp": "#000",
    "selfParameter": "#000",
    "semicolon": "#000",
    "string": "#000",
    "struct": "#000",
    "type": "#000",
    "typeParameter": "#000",
    "variable": "#000",

    // -- STANDARD MODIFIERS --
    "variable.abstract": "#000",
    "variable.async": "#000",
    "variable.declaration": "#000",
    "variable.defaultLibrary": "#000",
    "variable.definition": "#000",
    "variable.deprecated": "#000",
    "variable.documentation": "#000",
    "variable.modification": "#000",
    "variable.readonly": "#000",
    "variable.static": "#000",

    // -- NON-STANDARD --
    "defaultLibrary": "#000"
  }
}
