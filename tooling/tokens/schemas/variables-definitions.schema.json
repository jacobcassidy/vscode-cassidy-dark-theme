{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Variables definitions",
  "$ref": "#/definitions/branch",
  "definitions": {
    "branch": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "\\S"
              },
              "alpha": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "colorReason": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "additionalProperties": false,
            "required": [
              "color"
            ]
          },
          {
            "$ref": "#/definitions/branch"
          }
        ]
      }
    }
  }
}
