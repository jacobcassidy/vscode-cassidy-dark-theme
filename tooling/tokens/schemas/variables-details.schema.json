{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Variables details",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "description": {
        "type": "string",
        "pattern": "\\S"
      },
      "descriptionAddedIn": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      },
      "descriptionUpdatedIn": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      },
      "descriptionBasedOn": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      },
      "inherits": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "overrides": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "globallyOverriddenBy": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "additionalProperties": false,
    "minProperties": 1
  }
}
