{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared semantic definitions",
  "type": "object",
  "properties": {
    "standard": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(\\*|[a-zA-Z][\\w-]*)(:[a-zA-Z][\\w+-]*)?$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-zA-Z][\\w-]*(\\.[a-zA-Z][\\w-]*)*$"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "$token": {
              "const": true
            }
          },
          "additionalProperties": false,
          "required": [
            "$token"
          ]
        }
      }
    },
    "sourceCode": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(\\*|[a-zA-Z][\\w-]*)(:[a-zA-Z][\\w+-]*)?$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-zA-Z][\\w-]*(\\.[a-zA-Z][\\w-]*)*$"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "$token": {
              "const": true
            }
          },
          "additionalProperties": false,
          "required": [
            "$token"
          ]
        }
      }
    },
    "nonStandard": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(\\*|[a-zA-Z][\\w-]*)(:[a-zA-Z][\\w+-]*)?$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-zA-Z][\\w-]*(\\.[a-zA-Z][\\w-]*)*$"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "$token": {
              "const": true
            },
            "use": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "additionalProperties": false,
          "required": [
            "$token"
          ]
        }
      }
    },
    "deprecated": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(\\*|[a-zA-Z][\\w-]*)(:[a-zA-Z][\\w+-]*)?$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-zA-Z][\\w-]*(\\.[a-zA-Z][\\w-]*)*$"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "$token": {
              "const": true
            }
          },
          "additionalProperties": false,
          "required": [
            "$token"
          ]
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "standard",
    "sourceCode",
    "nonStandard",
    "deprecated"
  ]
}
