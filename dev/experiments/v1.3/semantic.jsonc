{
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "*.abstract": "#ff0000",
    "*.async": "#ff0000",
    "*.builtin": "#ff0000",
    "*.callable": "#ff0000",
    "*.classMember": "#ff0000",
    "*.declaration": "#ff0000",
    "*.decorator": "#ff0000",
    "*.deprecated": "#ff0000",
    "*.documentation": "#ff0000",
    "*.escapeCharacter": "#ff0000",
    "*.invalid": "#ff0000",
    "*.keywordArgument": "#ff0000",
    "*.library": "#ff0000",
    "*.modification": "#ff0000",
    "*.overridden": "#ff0000",
    "*.readonly": "#ff0000",
    "*.static": "#ff0000",
    "*.typeHint": "#ff0000",
    "*.typeHintComment": "#ff0000",
    "arrow": "#ff0000",
    "bracket": "#ff0000",
    "builtinConstant": "#ff0000",
    "class": "#ff0000",
    "clsParameter": "#ff0000",
    "colon": "#ff0000",
    "comment": "#ff0000",
    "curlybrace": "#ff0000",
    "decorator": "#ff0000",
    "enum": "#ff0000",
    "enumMember": "#ff0000",
    "event": "#ff0000",
    "function": "#ff0000",
    "interface": "#ff0000",
    "intrinsic": "#ff0000",
    "keyword": "#ff0000",
    "label": "#ff0000",
    "macro": "#ff0000",
    "magicFunction": "#ff0000",
    "method": "#ff0000",
    "module": "#ff0000",
    "namespace": "#ff0000",
    "number": "#ff0000",
    "operator": "#ff0000",
    "parameter": "#ff0000",
    "parenthesis": "#ff0000",
    "property": "#ff0000",
    "regexp": "#ff0000",
    "selfParameter": "#ff0000",
    "semicolon": "#ff0000",
    "string": "#ff0000",
    "struct": "#ff0000",
    "type": "#ff0000",
    "typeParameter": "#ff0000",
    "variable": "#ff0000",

    // Other examples - not in scheme
    "defaultLibrary": "#ff0",
    "parameter.readwrite": "#ff0",
    "variable.defaultLibrary": "#ff0",
    "variable.definition": "#ff0"
  }
}
