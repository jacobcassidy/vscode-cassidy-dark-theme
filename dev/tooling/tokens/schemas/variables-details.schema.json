{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Variables details",
  "definitions": {
    "detail": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "descriptionAddedIn": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "descriptionUpdatedIn": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "descriptionBasedOn": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "inherits": {
          "$ref": "#/definitions/relationships"
        },
        "overrides": {
          "$ref": "#/definitions/relationships"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "branch": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/node"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]*(\\.[a-zA-Z0-9-]+)*$"
      },
      "minProperties": 1
    },
    "node": {
      "anyOf": [
        {
          "$ref": "#/definitions/detail"
        },
        {
          "$ref": "#/definitions/branch"
        }
      ]
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "type": "object",
  "properties": {
    "default": {
      "$ref": "#/definitions/node"
    },
    "diagnostic": {
      "$ref": "#/definitions/node"
    },
    "diff": {
      "$ref": "#/definitions/node"
    }
  },
  "additionalProperties": false,
  "minProperties": 1
}
