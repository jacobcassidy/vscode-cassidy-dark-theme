{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Theme semantic details",
  "type": "object",
  "properties": {
    "standard": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:\\*|[a-zA-Z][\\w-]*)(?:\\.[a-zA-Z][\\w-]*)*(?::[a-zA-Z][\\w+-]*)?$"
      },
      "additionalProperties": false
    },
    "sourceCode": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:\\*|[a-zA-Z][\\w-]*)(?:\\.[a-zA-Z][\\w-]*)*(?::[a-zA-Z][\\w+-]*)?$"
      },
      "additionalProperties": false
    },
    "nonStandard": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:\\*|[a-zA-Z][\\w-]*)(?:\\.[a-zA-Z][\\w-]*)*(?::[a-zA-Z][\\w+-]*)?$"
      },
      "additionalProperties": false
    },
    "deprecated": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:\\*|[a-zA-Z][\\w-]*)(?:\\.[a-zA-Z][\\w-]*)*(?::[a-zA-Z][\\w+-]*)?$"
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "standard",
    "sourceCode",
    "nonStandard",
    "deprecated"
  ]
}
