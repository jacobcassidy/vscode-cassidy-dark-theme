{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared ui definitions",
  "type": "object",
  "properties": {
    "standard": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:_root|[a-zA-Z][\\w-]*(?:\\.[a-zA-Z][\\w-]*)*)$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w-]*$"
            }
          }
        }
      ]
    },
    "sourceCode": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:_root|[a-zA-Z][\\w-]*(?:\\.[a-zA-Z][\\w-]*)*)$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w-]*$"
            }
          }
        }
      ]
    },
    "nonStandard": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:_root|[a-zA-Z][\\w-]*(?:\\.[a-zA-Z][\\w-]*)*)$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w-]*$"
            }
          }
        }
      ]
    },
    "deprecated": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:_root|[a-zA-Z][\\w-]*(?:\\.[a-zA-Z][\\w-]*)*)$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w-]*$"
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "standard",
    "sourceCode",
    "nonStandard",
    "deprecated"
  ]
}
