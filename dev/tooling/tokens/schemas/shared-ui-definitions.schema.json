{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared ui definitions",
  "type": "object",
  "properties": {
    "standard": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/standard"
      }
    },
    "sourceCode": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/sourceCode"
      }
    },
    "nonStandard": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/nonStandard"
      }
    },
    "deprecated": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/deprecated"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "standard",
    "sourceCode",
    "nonStandard",
    "deprecated"
  ],
  "definitions": {
    "standard": {
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-zA-Z][\\w-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/standard"
          }
        },
        {
          "type": "object",
          "properties": {
            "$token": {
              "const": true
            },
            "use": false
          },
          "additionalProperties": {
            "$ref": "#/definitions/standard"
          },
          "required": [
            "$token"
          ],
          "propertyNames": {
            "anyOf": [
              {
                "pattern": "^[a-zA-Z][\\w-]*$"
              },
              {
                "const": "$token"
              }
            ]
          }
        }
      ]
    },
    "sourceCode": {
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-zA-Z][\\w-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/sourceCode"
          }
        },
        {
          "type": "object",
          "properties": {
            "$token": {
              "const": true
            },
            "use": false
          },
          "additionalProperties": {
            "$ref": "#/definitions/sourceCode"
          },
          "required": [
            "$token"
          ],
          "propertyNames": {
            "anyOf": [
              {
                "pattern": "^[a-zA-Z][\\w-]*$"
              },
              {
                "const": "$token"
              }
            ]
          }
        }
      ]
    },
    "nonStandard": {
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-zA-Z][\\w-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/nonStandard"
          }
        },
        {
          "type": "object",
          "properties": {
            "$token": {
              "const": true
            },
            "use": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/nonStandard"
          },
          "required": [
            "$token"
          ],
          "propertyNames": {
            "anyOf": [
              {
                "pattern": "^[a-zA-Z][\\w-]*$"
              },
              {
                "const": "$token"
              }
            ]
          }
        }
      ]
    },
    "deprecated": {
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-zA-Z][\\w-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/deprecated"
          }
        },
        {
          "type": "object",
          "properties": {
            "$token": {
              "const": true
            },
            "use": false
          },
          "additionalProperties": {
            "$ref": "#/definitions/deprecated"
          },
          "required": [
            "$token"
          ],
          "propertyNames": {
            "anyOf": [
              {
                "pattern": "^[a-zA-Z][\\w-]*$"
              },
              {
                "const": "$token"
              }
            ]
          }
        }
      ]
    }
  }
}
