{
  "name": "cassidy-dark",
  "displayName": "Cassidy Dark Theme",
  "version": "1.2.1",
  "description": "A clean, modern, dark theme originally inspired by Monokai",
  "publisher": "jacobcassidy",
  "author": {
    "name": "Jacob Cassidy",
    "email": "hello@jacobcassidy.com",
    "url": "https://jacobcassidy.com"
  },
  "icon": "images/cassidy-dark-logo-512.png",
  "galleryBanner": {
    "color": "#292929",
    "theme": "dark"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacobcassidy/vscode-cassidy-dark-theme"
  },
  "bugs": {
    "url": "https://github.com/jacobcassidy/vscode-cassidy-dark-theme/issues"
  },
  "license": "MIT",
  "keywords": [
    "Theme",
    "Dark Theme",
    "Monokai",
    "Night Theme"
  ],
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "jsonc-parser": "^3.3.1",
    "lefthook": "^2.1.12",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-multiline-arrays": "^4.1.11"
  },
  "allowScripts": {
    "lefthook@2.1.12": true,
    "unrs-resolver@1.12.2": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "engines": {
    "vscode": "^1.64.2"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Cassidy Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/cassidy-dark-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build:palette": "node scripts/build-theme.js --palette-only",
    "build:theme": "node scripts/build-theme.js",
    "check:generated": "node scripts/build-theme.js --check",
    "check": "npm run check:generated && npm run check:prettier && npm run lint && npm run check:theme && npm test",
    "check:prettier": "prettier . --check",
    "check:theme": "node scripts/check-theme.js",
    "dev:sync": "npm run build:theme && node scripts/dev/sync.js",
    "format": "prettier . --write",
    "lint": "npm run lint:md && npm run lint:es",
    "lint:es": "eslint",
    "lint:es:fix": "eslint --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" --fix",
    "package:vsix": "bash scripts/release/package.sh",
    "release:github-recover": "bash scripts/release/create-github-release.sh",
    "release:publish": "bash scripts/release/publish-azure.sh",
    "test": "node --test"
  }
}
