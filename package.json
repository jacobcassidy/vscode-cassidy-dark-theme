{
  "name": "cassidy-dark",
  "displayName": "Cassidy Dark Theme",
  "version": "1.2.1",
  "description": "A clean, modern, dark theme originally inspired by Monokai",
  "publisher": "jacobcassidy",
  "author": {
    "name": "Jacob Cassidy",
    "email": "hello@jacobcassidy.com",
    "url": "https://jacobcassidy.com"
  },
  "icon": "images/cassidy-dark-logo-512.png",
  "galleryBanner": {
    "color": "#292929",
    "theme": "dark"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacobcassidy/vscode-cassidy-dark-theme"
  },
  "bugs": {
    "url": "https://github.com/jacobcassidy/vscode-cassidy-dark-theme/issues"
  },
  "license": "MIT",
  "keywords": [
    "Theme",
    "Dark Theme",
    "Monokai",
    "Night Theme"
  ],
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jsonc-parser": "^3.3.1",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-multiline-arrays": "^4.1.11"
  },
  "allowScripts": {
    "lefthook@2.2.2": true,
    "unrs-resolver@1.12.2": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "engines": {
    "vscode": "^1.64.2"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Cassidy Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/cassidy-dark-color-theme.json"
      }
    ]
  },
  "scripts": {
    "add:properties": "node scripts/themes/add-properties.js",
    "add:theme": "node scripts/themes/add-theme.js",
    "build": "node scripts/themes/build.js --all",
    "build:dev": "node scripts/themes/build.js --dev",
    "build:palette": "node scripts/themes/build.js --palette-only",
    "build:prod": "node scripts/themes/build.js",
    "check": "npm run check:generated && npm run check:prettier && npm run lint && npm run check:theme && npm test",
    "check:generated": "node scripts/themes/build.js --check && node scripts/themes/build.js --dev --check",
    "check:prettier": "prettier . --check",
    "check:theme": "node scripts/themes/check.js",
    "format": "prettier . --write",
    "lint": "npm run lint:md && npm run lint:es",
    "lint:es": "eslint",
    "lint:es:fix": "eslint --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" --fix",
    "package:vsix": "npm run check && bash scripts/release/package-vsix.sh",
    "release:github-recover": "bash scripts/release/publish/create-github-release.sh",
    "release:publish": "bash scripts/release/publish/run-azure-pipeline.sh",
    "sync": "npm run build && node scripts/dev-extension/sync.js",
    "test": "node --test \"tests/*.test.js\"",
    "watch": "node scripts/themes/watch.js"
  }
}
