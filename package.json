{
  "name": "cassidy-dark",
  "displayName": "Cassidy Dark Theme",
  "version": "1.2.1",
  "description": "A clean, modern, dark theme originally inspired by Monokai",
  "publisher": "jacobcassidy",
  "author": {
    "name": "Jacob Cassidy",
    "email": "hello@jacobcassidy.com",
    "url": "https://jacobcassidy.com"
  },
  "icon": "images/cassidy-dark-logo-512.png",
  "galleryBanner": {
    "color": "#292929",
    "theme": "dark"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacobcassidy/vscode-cassidy-dark-theme"
  },
  "bugs": {
    "url": "https://github.com/jacobcassidy/vscode-cassidy-dark-theme/issues"
  },
  "license": "MIT",
  "keywords": [
    "Theme",
    "Dark Theme",
    "Monokai",
    "Night Theme"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "acorn": "^8.19.0",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jsonc-parser": "^3.3.1",
    "lefthook": "^2.2.2",
    "markdown-it": "^15.0.3",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "typescript": "^6.0.3",
    "xml2js": "0.6.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "allowScripts": {
    "lefthook@2.2.2": true,
    "unrs-resolver@1.12.2": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "engines": {
    "vscode": "^1.64.2"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Cassidy Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/cassidy-dark-color-theme.json"
      }
    ]
  },
  "scripts": {
    "bootstrap": "node dev/scripts/themes/bootstrap.js",
    "build": "node dev/scripts/themes/build.js --all",
    "check": "npm run check:theme && npm run check:docs && npm run check:reachability && npm run check:prettier && npm run lint && npm test",
    "create": "node dev/scripts/themes/add-theme.js",
    "fill": "node dev/scripts/themes/add-properties.js",
    "format": "prettier . --write",
    "lint": "npm run lint:md && npm run lint:es",
    "package": "npm run check && bash dev/scripts/release/package-vsix.sh",
    "publish": "bash dev/scripts/release/publish/run-azure-pipeline.sh",
    "recover": "node dev/scripts/release/publish/create-github-release.js",
    "refresh": "node dev/scripts/token-data/update-token-details.js",
    "test": "node --test \"dev/tests/**/*.test.js\"",
    "watch": "node dev/scripts/themes/watch.js",
    "build:dev": "node dev/scripts/themes/build.js --dev",
    "build:palette": "node dev/scripts/themes/build.js --palette-only",
    "build:prod": "node dev/scripts/themes/build.js",
    "check:docs": "node dev/scripts/docs/check.js",
    "check:generated": "node dev/scripts/themes/build.js --all --check",
    "check:prettier": "prettier . --check",
    "check:reachability": "node dev/scripts/maintenance/check-reachability.js",
    "check:theme": "node dev/scripts/themes/check.js",
    "check:visual": "node dev/scripts/visual/check.js",
    "lint:es": "eslint",
    "lint:es:fix": "eslint --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" --fix"
  }
}
