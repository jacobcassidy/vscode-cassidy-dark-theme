{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "typescript.ts",
    "tsx.tsx"
  ]
}
