        "color": "palette.purple.400",
        "details": {
          "for": "Terminal ANSI magenta."
        }
      },
      "ansiRed": {
        "color": "palette.red.400",
        "details": {
          "for": "Terminal ANSI red."
        }
      },
      "ansiWhite": {
        "color": "palette.gray.000",
        "details": {
          "for": "Terminal ANSI white."
        }
      },
      "ansiYellow": {
        "color": "palette.yellow.400",
        "details": {
          "for": "Terminal ANSI yellow."
        }
      },
      "background": {
        "color": "palette.gray.900",
        "details": {
          "for": "Terminal backgrounds in the editor, panel, or sidebar.",
          "inherits": [
            "editor.background",
            "panel.background",
            "sideBar.background"
          ]
        }
      },
      "foreground": {
        "color": "palette.gray.200",
        "details": {
          "for": "The foreground color of the terminal."
        }
      }
    },
    // The marker strip beside the integrated terminal scrollbar.
    "terminalOverviewRuler": {
      "cursorForeground": {
        "color": "palette.gray.400",
        "details": {
          "for": "The overview ruler cursor color."
        }
      }
    },
    // Block quotes in rendered text, such as Markdown previews.
    "textBlockQuote": {
      "background": {
        "color": "palette.gray.800",
        "details": {
          "for": "Background color for block quotes in text."
        }
      },
      "border": {
        "color": "palette.gray.600",
        "details": {
          "for": "Border color for block quotes in text."
        }
      }
    },
    // Fenced or multiline code blocks in rendered text.
    "textCodeBlock": {
      "background": {
        "color": "palette.gray.white",
        "alpha": 0.14901960784313725,
        "details": {
          "for": "Background color for code blocks in text."
        }
      }
    },
    // Clickable links in rendered text, settings, and other workbench content.
    "textLink": {
      "activeForeground": {
        "color": "palette.yellow.400",
        "details": {
          "for": "Foreground color for links in text when clicked on and on mouse hover."
        }
      },
      "foreground": {
        "color": "palette.blue.400",
        "details": {
          "for": "Foreground color for links in text."
        }
      }
    },
    // Preformatted text segments, such as inline code in rendered content.
    "textPreformat": {
      "background": {
        "color": "palette.gray.800",
        "details": {
          "for": "Background color for preformatted text segments."
        }
      },
      "foreground": {
        "color": "palette.yellow.500",
        "details": {
          "for": "Foreground color for preformatted text segments."
        }
      }
    },
    // The window title bar in active and inactive windows.
    "titleBar": {
      "activeBackground": {
        "color": "palette.gray.800",
        "details": {
          "for": "Title bar background when the window is active."
        }
      },
      "activeForeground": {
        "color": "palette.gray.400",
        "details": {
          "for": "Title bar foreground when the window is active."
        }
      },
      "inactiveBackground": {
        "color": "palette.gray.850",
        "details": {
          "for": "Title bar background when the window is inactive.",
          "inherits": [
            "titleBar.activeBackground"
          ]
        }
      },
      "inactiveForeground": {
        "color": "palette.gray.600",
        "details": {
          "for": "Title bar foreground when the window is inactive.",
          "inherits": [
            "titleBar.activeForeground"
          ]
        }
      }
    },
    // Action toolbars when their buttons are hovered.
    "toolbar": {
      "hoverBackground": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Toolbar background when hovering over actions using the mouse."
        }
      }
    },
    // Indentation guides and table row or column separators in tree views.
    "tree": {
      "indentGuidesStroke": {
        "color": "palette.gray.700",
        "details": {
          "for": "Tree stroke color for the indentation guides."
        }
      },
      "tableColumnsBorder": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Table border color between columns."
        }
      },
      "tableOddRowsBackground": {
        "color": "palette.gray.850",
        "details": {
          "for": "Background color for odd table rows.",
          "inherits": [
            "foreground"
          ]
        }
      }
    },
    // Step headings in guided walkthrough pages.
    "walkthrough": {
      "stepTitle": {
        "foreground": {
          "color": "palette.gray.000",
          "details": {
            "for": "Foreground color of the heading of each walkthrough step."
          }
        }
      }
    },
    // Progress indicators on the Welcome and Getting Started pages.
    "welcomePage": {
      "progress": {
        "background": {
          "color": "palette.gray.825",
          "details": {
            "for": "Welcome page progress tracks.",
            "inherits": [
              "input.background"
            ]
          }
        },
        "foreground": {
          "color": "palette.green.400",
          "details": {
            "for": "Welcome page progress fills.",
            "inherits": [
              "textLink.foreground"
            ]
          }
        }
      }
    },
    // Shared borders and shadows for widgets such as Find and Replace.
    "widget": {
      "border": {
        "color": "palette.gray.white",
        "alpha": 0.050980392156862744,
        "details": {
          "for": "Border color of widgets such as find/replace inside the editor."
        }
      },
      "shadow": {
        "color": "palette.gray.black",
        "alpha": 0.2,
        "details": {
          "for": "Shadow color of widgets such as find/replace inside the editor."
        }
      }
    }
  },
  // Editor symbols colored using semantic information from language services.
  "semantic": {
    // Class names in editor code when semantic highlighting is available.
    "class": {
      "color": "syntax.function",
      "details": {
        "for": "Semantic class symbols.",
        "inherits": [
          "scope:entity.name.type.class",
          "scope:support.class"
        ]
      }
    },
    // Function names in editor code when semantic highlighting is available.
    "function": {
      "color": "syntax.function",
      "details": {
        "for": "Semantic function symbols.",
        "inherits": [
          "scope:entity.name.function",
          "scope:support.function"
        ]
      }
    },
    // Built-in function names identified by the language service.
    "function.defaultLibrary": {
      "color": "syntax.support",
      "details": {
        "for": "Semantic built-in function symbols.",
        "inherits": [
          "semantic.function",
          "scope:support.function"
        ]
      }
    },
    // Member function names identified by the language service.
    "method": {
      "color": "syntax.support",
      "details": {
        "for": "Semantic method symbols.",
        "inherits": [
          "scope:entity.name.function.member",
          "scope:support.function"
        ]
      }
    },
    // Namespace names identified by the language service.
    "namespace": {
      "color": "syntax.constant",
      "details": {
        "for": "Semantic namespace symbols.",
        "inherits": [
          "scope:entity.name.namespace"
        ]
      }
    },
    // Function and method parameters identified by the language service.
    "parameter": {
      "color": "syntax.parameter",
      "details": {
        "for": "Semantic parameter symbols.",
        "inherits": [
          "scope:variable.parameter"
        ]
      }
    },
    // Object and member property names identified by the language service.
    "property": {
      "color": "syntax.property",
      "details": {
        "for": "Semantic property symbols.",
        "inherits": [
          "scope:variable.other.property"
        ]
      }
    },
    // Variable names in editor code when semantic highlighting is available.
    "variable": {
      "color": "syntax.variable",
      "details": {
        "for": "Semantic variable symbols.",
        "inherits": [
          "scope:variable.other.readwrite",
          "scope:entity.name.variable"
        ]
      }
    },
    // Built-in variable and library object names identified by the language service.
    "variable.defaultLibrary": {
      "color": "syntax.defaultLibrary",
      "details": {
        "for": "Semantic built-in variable symbols.",
        "inherits": [
          "semantic.variable",
          "scope:support.variable",
          "scope:support.other.variable"
        ]
      }
    }
  },
  // Editor text colored by TextMate grammar scopes, including code and markup.
  "syntax": {
    // Built-in functions, HTML text, and support names.
    "support": {
      "color": "palette.gray.000",
      "details": {
        "for": "Built-in functions, HTML text, and support names."
      }
    },
    // Library objects and shell scope names.
    "defaultLibrary": {
      "color": "palette.gray.150",
      "details": {
        "for": "Library objects and shell scope names."
      }
    },
    // Embedded text and attribute names.
    "text": {
      "color": "palette.gray.200",
      "details": {
        "for": "Embedded text and attribute names."
      }
    },
    // Punctuation, brackets, and generic names.
    "punctuation": {
      "color": "palette.gray.400",
      "details": {
        "for": "Punctuation, brackets, and generic names."
      }
    },
    // Comments and comment punctuation.
    "comment": {
      "color": "palette.gray.500",
      "details": {
        "for": "Comments and comment punctuation."
      }
    },
    // Invalid code and Markdown link underlines.
    "invalid": {
      "color": "palette.gray.600",
      "details": {
        "for": "Invalid code and Markdown link underlines."
      }
    },
    // Type keywords, paths, and linked text.
    "storageType": {
      "color": "palette.blue.400",
      "details": {
        "for": "Type keywords, paths, and linked text."
      }
    },
    // PHP type hints and TypeScript type operators.
    "typeHint": {
      "color": "palette.blue.400-muted",
      "details": {
        "for": "PHP type hints and TypeScript type operators."
      }
    },
    // Links inside struck-through Markdown text.
    "linkStrikethrough": {
      "color": "palette.blue.400",
      "alpha": 0.5019607843137255,
      "details": {
        "for": "Links inside struck-through Markdown text."
      }
    },
    // Function and type names.
    "function": {
      "color": "palette.cyan.400",
      "details": {
        "for": "Function and type names."
      }
    },
    // Properties, labels, and CSS classes.
    "property": {
      "color": "palette.green.400",
      "details": {
        "for": "Properties, labels, and CSS classes."
      }
    },
    // Parameters, CSS IDs, and keyframe offsets.
    "parameter": {
      "color": "palette.orange.400",
      "details": {
        "for": "Parameters, CSS IDs, and keyframe offsets."
      }
    },
    // Variables and variable sigils.
    "variable": {
      "color": "palette.pink.400",
      "details": {
        "for": "Variables and variable sigils."
      }
    },
    // Constants, units, and regular expressions.
    "constant": {
      "color": "palette.purple.400",
      "details": {
        "for": "Constants, units, and regular expressions."
      }
    },
    // Attribute namespace prefixes.
    "attributeNamespace": {
      "color": "palette.purple.500",
      "details": {
        "for": "Attribute namespace prefixes."
      }
    },
    // Keywords, tags, and storage modifiers.
    "keyword": {
      "color": "palette.red.400",
      "details": {
        "for": "Keywords, tags, and storage modifiers."
      }
    },
    // Strings and selected Markdown text.
    "string": {
      "color": "palette.yellow.400",
      "details": {
        "for": "Strings and selected Markdown text."
      }
    },
    // Inline Markdown code.
    "code": {
      "color": "palette.yellow.500",
      "details": {
        "for": "Inline Markdown code."
      }
    }
  },
  // Shared background roles for editor surfaces.
  "surface": {
    // The shared background role available to editor surfaces.
    "editor": {
      "color": "palette.gray.900",
      "details": {
        "for": "Shared editor background role."
      }
    }
  },
  // Shared foreground roles for text across the theme.
  "text": {
    // The shared foreground role available to ordinary text.
    "default": {
      "color": "palette.gray.200",
      "details": {
        "for": "Shared default text role."
      }
    }
  },
  // Shared color roles for error and warning diagnostics.
  "diagnostic": {
    // Shared error colors for diagnostic underlines and indicators.
    "error": {
      "foreground": {
        "color": "palette.red.500",
        "details": {
          "for": "Shared error diagnostic foreground role."
        }
      }
    },
    // Shared warning colors for diagnostic underlines and indicators.
    "warning": {
      "foreground": {
        "color": "palette.orange.400",
        "details": {
          "for": "Shared warning diagnostic foreground role."
        }
      }
    }
  },
  // Shared color roles for added and removed content in change views.
  "diff": {
    // Shared colors for inserted lines and other added content.
    "added": {
      "foreground": {
        "color": "palette.green.400",
        "details": {
          "for": "Shared added-content foreground role."
        }
      }
    },
    // Shared colors for deleted lines and other removed content.
    "removed": {
      "foreground": {
        "color": "palette.red.400",
        "details": {
          "for": "Shared removed-content foreground role."
        }
      }
    }
  }
