{
  // Workbench controls and surfaces outside the syntax-colored text of a file.
  "ui": {
    // The bar of view icons beside the sidebar, such as Explorer, Search, and Source Control.
    "activityBar": {
      "activeBackground": {
        "color": "palette.gray.875",
        "details": {
          "for": "Active activity bar item backgrounds."
        }
      },
      "background": {
        "color": "palette.gray.825",
        "details": {
          "for": "Activity bar backgrounds."
        }
      },
      "dropBorder": {
        "color": "palette.gray.white",
        "alpha": 0.5019607843137255,
        "details": {
          "for": "Activity bar drag and drop indicators.",
          "inherits": [
            "activityBar.foreground"
          ]
        }
      },
      "foreground": {
        "color": "palette.yellow.400",
        "details": {
          "for": "Active activity bar icons."
        }
      },
      "inactiveForeground": {
        "color": "palette.gray.500",
        "details": {
          "for": "Inactive activity bar icons.",
          "inherits": [
            "activityBar.foreground"
          ]
        }
      }
    },
    // Notification and count badges on activity bar icons.
    "activityBarBadge": {
      "background": {
        "color": "palette.yellow.400",
        "details": {
          "for": "Activity bar notification badge backgrounds."
        }
      },
      "foreground": {
        "color": "palette.gray.1000",
        "details": {
          "for": "Activity bar notification badge text."
        }
      }
    },
    // Small count labels, such as Problems totals and search result counts.
    "badge": {
      "background": {
        "color": "palette.gray.700",
        "details": {
          "for": "Count badge backgrounds, such as Problems totals."
        }
      },
      "foreground": {
        "color": "palette.gray.000",
        "details": {
          "for": "Count badge text."
        }
      }
    },
    // Primary and secondary buttons in dialogs, settings, and other workbench views.
    "button": {
      "background": {
        "color": "#1c6bc4",
        "details": {
          "for": "Primary button backgrounds."
        },
        "reason": "Primary button fill uses L53/H255 with gamut headroom, allowing its lighter blue 600 hover state to retain at least 4.5:1 contrast with the button text."
      },
      "foreground": {
        "color": "palette.gray.000",
        "details": {
          "for": "Primary button text."
        }
      },
      "hoverBackground": {
        "color": "palette.blue.600",
        "details": {
          "for": "Primary button backgrounds on hover.",
          "inherits": [
            "button.background"
          ]
        }
      },
      "secondaryBackground": {
        "color": "palette.gray.700",
        "details": {
          "for": "Secondary button backgrounds.",
          "inherits": [
            "list.hoverBackground"
          ]
        }
      },
      "secondaryForeground": {
        "color": "palette.gray.000",
        "details": {
          "for": "Secondary button text.",
          "inherits": [
            "foreground"
          ]
        }
      },
      "secondaryHoverBackground": {
        "color": "palette.gray.650",
        "details": {
          "for": "Secondary button backgrounds on hover.",
          "inherits": [
            "list.hoverBackground"
          ]
        }
      }
    },
    // Chart accents, including colored markers in source control graphs.
    "charts": {
      "green": {
        "color": "palette.green.400",
        "details": {
          "for": "Green chart markers, including source control graphs."
        }
      },
      "orange": {
        "color": "palette.orange.400",
        "details": {
          "for": "Orange chart markers, including source control graphs."
        }
      },
      "purple": {
        "color": "palette.purple.400",
        "details": {
          "for": "Purple chart markers, including source control graphs."
        }
      }
    },
    // Start, pause, restart, and stop icons in debugging controls.
    "debugIcon": {
      "pauseForeground": {
        "color": "palette.blue.400",
        "details": {
          "for": "Debug toolbar icon for pause."
        }
      },
      "restartForeground": {
        "color": "palette.green.400",
        "details": {
          "for": "Debug toolbar icon for restart."
        }
      },
      "startForeground": {
        "color": "palette.green.400",
        "details": {
          "for": "Debug toolbar icon for start debugging."
        }
      },
      "stopForeground": {
        "color": "palette.red.400",
        "details": {
          "for": "Debug toolbar icon for stop."
        }
      }
    },
    // The toolbar shown during a debugging session.
    "debugToolBar": {
      "background": {
        "color": "palette.gray.800",
        "details": {
          "for": "Debug toolbar background color."
        }
      }
    },
    // Changed text, lines, and collapsed unchanged regions in file comparisons.
    "diffEditor": {
      "diagonalFill": {
        "color": "palette.gray.700",
        "details": {
          "for": "Color of the diff editor's diagonal fill."
        }
      },
      "insertedLineBackground": {
        "color": "diff.added.foreground",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Background color for lines that got inserted."
        }
      },
      "insertedTextBackground": {
        "color": "diff.added.foreground",
        "alpha": 0.2,
        "details": {
          "for": "Background color for text that got inserted."
        }
      },
      "removedLineBackground": {
        "color": "diff.removed.foreground",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Background color for lines that got removed."
        }
      },
      "removedTextBackground": {
        "color": "diff.removed.foreground",
        "alpha": 0.2,
        "details": {
          "for": "Background color for text that got removed."
        }
      },
      "unchangedCodeBackground": {
        "color": "palette.blue.400",
        "alpha": 0.050980392156862744,
        "details": {
          "for": "The background color of unchanged code in the diff editor."
        }
      },
      "unchangedRegionBackground": {
        "color": "palette.blue.400",
        "alpha": 0.050980392156862744,
        "details": {
          "for": "The background color of unchanged blocks in the diff editor.",
          "inherits": [
            "sideBar.background"
          ]
        }
      },
      "unchangedRegionForeground": {
        "color": "palette.gray.400",
        "details": {
          "for": "The foreground color of unchanged blocks in the diff editor.",
          "inherits": [
            "foreground"
          ]
        }
      },
      "unchangedRegionShadow": {
        "color": "palette.gray.black",
        "alpha": 0.2,
        "details": {
          "for": "The color of the shadow around unchanged region widgets."
        }
      }
    },
    // The line-number margins beside added and removed lines in file comparisons.
    "diffEditorGutter": {
      "insertedLineBackground": {
        "color": "diff.added.foreground",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Background color for the margin where lines got inserted."
        }
      },
      "removedLineBackground": {
        "color": "diff.removed.foreground",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Background color for the margin where lines got removed."
        }
      }
    },
    // Text and icons when a workbench control is disabled.
    "disabledForeground": {
      "color": "palette.gray.white",
      "alpha": 0.2,
      "details": {
        "for": "Disabled workbench text and icons."
      }
    },
    // Select controls and their open menus, such as the Output channel selector.
    "dropdown": {
      "background": {
        "color": "palette.gray.800",
        "details": {
          "for": "Dropdown background."
        }
      },
      "border": {
        "color": "palette.gray.700",
        "details": {
          "for": "Dropdown border.",
          "inherits": [
            "dropdown.background"
          ]
        }
      },
      "foreground": {
        "color": "palette.gray.200",
        "details": {
          "for": "Dropdown foreground."
        }
      },
      "listBackground": {
        "color": "palette.gray.825",
        "details": {
          "for": "Dropdown list background.",
          "inherits": [
            "dropdown.background"
          ]
        }
      }
    },
    // The main text editor, including selections, search matches, folds, and line highlights.
    "editor": {
      "background": {
        "color": "surface.editor",
        "details": {
          "for": "Editor backgrounds."
        }
      },
      "findMatchBackground": {
        "color": "palette.purple.600",
        "alpha": 0.9019607843137255,
        "details": {
          "for": "Current search match backgrounds."
        }
      },
      "findMatchForeground": {
        "color": "palette.purple.500",
        "alpha": 0.9019607843137255,
        "details": {
          "for": "Current search match text."
        }
      },
      "findMatchHighlightBackground": {
        "color": "palette.purple.600",
        "alpha": 0.45098039215686275,
        "details": {
          "for": "Other search match backgrounds."
        }
      },
      "findMatchHighlightForeground": {
        "color": "palette.gray.white",
        "alpha": 0.9019607843137255,
        "details": {
          "for": "Other search match text."
        }
      },
      "findRangeHighlightBackground": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Selected search range backgrounds."
        }
      },
      "foldBackground": {
        "color": "palette.blue.400",
        "alpha": 0.14901960784313725,
        "details": {
          "for": "Background color behind folded ranges.",
          "inherits": [
            "editor.selectionBackground"
          ]
        }
      },
      "foldPlaceholderForeground": {
        "color": "palette.gray.400",
        "details": {
          "for": "Collapsed code placeholders."
        }
      },
      "foreground": {
        "color": "text.default",
        "details": {
          "for": "Default editor text."
        }
      },
      "hoverHighlightBackground": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Highlight below the word for which a hover is shown."
        }
      },
      "lineHighlightBackground": {
        "color": "palette.gray.975",
        "details": {
          "for": "Background color for the highlight of line at the cursor position."
        }
      },
      "lineHighlightBorder": {
        "color": "palette.gray.975",
        "details": {
          "for": "Background color for the border around the line at the cursor position."
        }
      },
      "rangeHighlightBackground": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Background color of highlighted ranges, like by quick open and find features."
        }
      },
      "selectionBackground": {
        "color": "palette.blue.600",
        "alpha": 0.5019607843137255,
        "details": {
          "for": "Color of the editor selection."
        }
      },
      "wordHighlightBackground": {
        "color": "palette.gray.500",
        "alpha": 0.5019607843137255,
        "details": {
          "for": "Background color of a symbol during read-access, like reading a variable."
        }
      },
      "wordHighlightStrongBackground": {
        "color": "palette.pink.400",
        "alpha": 0.4,
        "details": {
          "for": "Background color of a symbol during write-access, like writing to a variable."
        }
      }
    },
    // Matching bracket outlines when the cursor is beside a bracket.
    "editorBracketMatch": {
      "border": {
        "color": "palette.gray.600",
        "details": {
          "for": "Color for matching brackets boxes."
        }
      }
    },
    // Inline actions above code, such as references and run or debug links.
    "editorCodeLens": {
      "foreground": {
        "color": "palette.yellow.500",
        "details": {
          "for": "CodeLens actions above code."
        }
      }
    },
    // The text cursor and characters covered by a block cursor.
    "editorCursor": {
      "background": {
        "color": "palette.gray.800",
        "details": {
          "for": "The background color of the editor cursor."
        }
      },
      "foreground": {
        "color": "palette.gray.400",
        "details": {
          "for": "Color of the editor cursor."
        }
      }
    },
    // Error squiggles beneath code in the editor.
    "editorError": {
      "foreground": {
        "color": "diagnostic.error.foreground",
        "details": {
          "for": "Foreground color of error squigglies in the editor."
        }
      }
    },
    // Inline suggestion text shown before accepting a completion.
    "editorGhostText": {
      "foreground": {
        "color": "palette.blue.500",
        "details": {
          "for": "Inline suggestion text."
        }
      }
    },
    // Containers for open editors, including split boundaries and drag targets.
    "editorGroup": {
      "border": {
        "color": "palette.gray.black",
        "alpha": 0.5019607843137255,
        "details": {
          "for": "Color to separate multiple editor groups from each other."
        }
      },
      "dropBackground": {
        "color": "palette.gray.400",
        "alpha": 0.5019607843137255,
        "details": {
          "for": "Background color when dragging editors around."
        }
      }
    },
    // The header behind the tabs of an editor group.
    "editorGroupHeader": {
      "tabsBackground": {
        "color": "palette.gray.850",
        "details": {
          "for": "Background color of the editor group title header when tabs are enabled."
        }
      }
    },
    // The margin beside code containing change markers and comment range indicators.
    "editorGutter": {
      "addedBackground": {
        "color": "palette.green.400",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Editor gutter background color for lines that are added."
        }
      },
      "commentRangeForeground": {
        "color": "palette.gray.800",
        "details": {
          "for": "Comment range markers in the editor gutter.",
          "inherits": [
            "list.inactiveSelectionBackground",
            "editor.background"
          ]
        }
      },
      "deletedBackground": {
        "color": "palette.red.400",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Editor gutter background color for lines that are deleted.",
          "inherits": [
            "editorError.foreground"
          ]
        }
      },
      "modifiedBackground": {
        "color": "palette.yellow.400",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Editor gutter background color for lines that are modified."
        }
      }
    },
    // Subtle hint markers beneath code in the editor.
    "editorHint": {
      "foreground": {
        "color": "palette.blue.400",
        "details": {
          "for": "Foreground color of hint squigglies in the editor."
        }
      }
    },
    // Vertical guides showing indentation levels in the editor.
    "editorIndentGuide": {
      "activeBackground1": {
        "color": "palette.gray.700",
        "details": {
          "for": "Color of the active editor indentation guides (1).",
          "inherits": [
            "editorIndentGuide.activeBackground"
          ]
        }
      }
    },
    // Informational diagnostic squiggles beneath code.
    "editorInfo": {
      "foreground": {
        "color": "palette.blue.400",
        "details": {
          "for": "Foreground color of info squigglies in the editor."
        }
      }
    },
    // The lightbulb shown when code actions are available.
    "editorLightBulb": {
      "foreground": {
        "color": "palette.yellow.500",
        "details": {
          "for": "The color used for the lightbulb actions icon."
        }
      }
    },
    // The lightbulb for AI-assisted code actions.
    "editorLightBulbAi": {
      "foreground": {
        "color": "palette.yellow.500",
        "details": {
          "for": "The color used for the lightbulb AI icon.",
          "inherits": [
            "editorLightBulb.foreground"
          ]
        }
      }
    },
    // The lightbulb shown when an automatic code fix is available.
    "editorLightBulbAutoFix": {
      "foreground": {
        "color": "palette.blue.400",
        "details": {
          "for": "The color used for the lightbulb auto fix actions icon."
        }
      }
    },
    // Line numbers and the current line number beside the editor text.
    "editorLineNumber": {
      "activeForeground": {
        "color": "palette.gray.200",
        "details": {
          "for": "Color of editor active line number.",
          "inherits": [
            "editorActiveLineNumber.foreground"
          ]
        }
      },
      "foreground": {
        "color": "palette.gray.600",
        "details": {
          "for": "Color of editor line numbers."
        }
      }
    },
    // Links in editor text when they are activated or hovered.
    "editorLink": {
      "activeForeground": {
        "color": "palette.yellow.400",
        "details": {
          "for": "Color of active links."
        }
      }
    },
    // The narrow marker strip beside the editor scrollbar.
    "editorOverviewRuler": {
      "addedForeground": {
        "color": "palette.green.400",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Overview ruler marker color for added content.",
          "inherits": [
            "editorGutter.addedBackground"
          ]
        }
      },
      "background": {
        "color": "palette.gray.black",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Background color of the editor overview ruler."
        }
      },
      "border": {
        "color": "palette.gray.black",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Color of the overview ruler border."
        }
      },
      "bracketMatchForeground": {
        "color": "palette.gray.600",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Overview ruler marker color for matching brackets."
        }
      },
      "deletedForeground": {
        "color": "palette.red.400",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Overview ruler marker color for deleted content.",
          "inherits": [
            "editorGutter.deletedBackground"
          ]
        }
      },
      "errorForeground": {
        "color": "palette.red.500",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Overview ruler marker color for errors."
        }
      },
      "findMatchForeground": {
        "color": "palette.purple.600",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Overview ruler marker color for find matches."
        }
      },
      "infoForeground": {
        "color": "palette.blue.400",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Overview ruler marker color for infos.",
          "inherits": [
            "editorInfo.foreground"
          ]
        }
      },
      "modifiedForeground": {
        "color": "palette.yellow.400",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Overview ruler marker color for modified content.",
          "inherits": [
            "editorGutter.modifiedBackground"
          ]
        }
      },
      "selectionHighlightForeground": {
        "color": "palette.gray.500",
        "alpha": 0.3803921568627451,
        "details": {
          "for": "Overview ruler marker color for selection highlights."
        }
      },
      "warningForeground": {
        "color": "palette.orange.400",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Overview ruler marker color for warnings.",
          "inherits": [
            "editorWarning.foreground"
          ]
        }
      },
      "wordHighlightForeground": {
        "color": "palette.gray.500",
        "alpha": 0.3803921568627451,
        "details": {
          "for": "Overview ruler marker color for symbol highlights."
        }
      },
      "wordHighlightStrongForeground": {
        "color": "palette.pink.400",
        "alpha": 0.7490196078431373,
        "details": {
          "for": "Overview ruler marker color for write-access symbol highlights."
        }
      }
    },
    // Vertical column guides at configured ruler positions in the editor.
    "editorRuler": {
      "foreground": {
        "color": "palette.orange.400",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Color of the editor rulers."
        }
      }
    },
    // Pinned enclosing code lines at the top of the editor while scrolling.
    "editorStickyScroll": {
      "background": {
        "color": "palette.gray.875",
        "details": {
          "for": "Background color of sticky scroll in the editor.",
          "inherits": [
            "editor.background"
          ]
        }
      }
    },
    // Pinned code lines at the top of the editor when hovered.
    "editorStickyScrollHover": {
      "background": {
        "color": "palette.gray.975",
        "details": {
          "for": "Background color of sticky scroll on hover in the editor."
        }
      }
    },
    // Highlights around Unicode characters flagged for inspection.
    "editorUnicodeHighlight": {
      "background": {
        "color": "palette.orange.400",
        "alpha": 0.25098039215686274,
        "details": {
          "for": "Background color used to highlight unicode characters.",
          "inherits": [
            "editorWarning.background"
          ]
        }
      },
      "border": {
        "color": "palette.orange.400",
        "alpha": 0.5019607843137255,
        "details": {
          "for": "Border color used to highlight unicode characters.",
          "inherits": [
            "editorWarning.foreground"
          ]
        }
      }
    },
    // Warning squiggles beneath code in the editor.
    "editorWarning": {
      "foreground": {
        "color": "diagnostic.warning.foreground",
        "details": {
          "for": "Foreground color of warning squigglies in the editor."
        }
      }
    },
    // Visible spaces, tabs, and other whitespace markers in the editor.
    "editorWhitespace": {
      "foreground": {
        "color": "palette.gray.800",
        "details": {
          "for": "Color of whitespace characters in the editor."
        }
      }
    },
    // Widgets over editor text, such as Find and Replace.
    "editorWidget": {
      "background": {
        "color": "palette.gray.825",
        "details": {
          "for": "Background color of editor widgets, such as find/replace."
        }
      },
      "border": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549,
        "details": {
          "for": "Border color of editor widgets.",
          "inherits": [
            "editorWidget.foreground"
          ]
        }
      }
    },
    // Error messages across the workbench unless a component supplies its own color.
    "errorForeground": {
      "color": "diagnostic.error.foreground",
      "details": {
        "for": "Default error message text."
      }
    },
    // Rating, sponsor, and pre-release icons in extension views.
    "extensionIcon": {
      "preReleaseForeground": {
        "color": "palette.green.600",
        "alpha": 0.9019607843137255,
        "details": {
          "for": "The icon color for pre-release extension."
        }
      },
      "sponsorForeground": {
        "color": "palette.pink.600",
        "alpha": 0.9019607843137255,
        "details": {
          "for": "The icon color for extension sponsor."
        }
      },
      "starForeground": {
        "color": "palette.orange.500",
        "alpha": 0.9019607843137255,
        "details": {
          "for": "The icon color for extension ratings."
        }
      }
    },
    // Keyboard focus outlines unless a control supplies its own border.
    "focusBorder": {
      "color": "palette.blue.500",
      "alpha": 0.8,
      "details": {
        "for": "Default keyboard focus borders."
      }
    },
    // Default workbench text unless a component supplies its own foreground.
    "foreground": {
      "color": "palette.gray.200",
      "details": {
        "for": "Default workbench text."
      }
    },
    // File names and resource labels decorated by their Git status.
    "gitDecoration": {
      "addedResourceForeground": {
        "color": "palette.green.500",
        "details": {
          "for": "Color for added resources."
        }
      },
      "deletedResourceForeground": {
        "color": "palette.red.500",
        "details": {
          "for": "Color for deleted resources."
        }
      },
      "ignoredResourceForeground": {
        "color": "palette.gray.450",
        "details": {
          "for": "Color for ignored resources."
        }
      },
