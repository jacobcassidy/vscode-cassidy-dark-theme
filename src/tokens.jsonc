{
  "ui": {
    "activityBar": {
      // [base] (match `sideBar.background`)
      "activeBackground": {
        "color": "palette.gray.875"
      },
      // -color--oklch-32-gray [overrides core #3333333] (match sidebar header)
      "background": {
        "color": "palette.gray.825"
      },
      // -color--white at 50% opacity [overrides `activityBar.foreground`]
      "dropBorder": {
        "color": "palette.gray.white",
        "alpha": 0.5019607843137255
      },
      // palette.yellow.400 [overrides core #ffffff]
      "foreground": {
        "color": "palette.yellow.400"
      },
      // -color--gray-medium-dark [overrides core #858585] (match comment)
      "inactiveForeground": {
        "color": "palette.gray.500"
      }
    },
    "activityBarBadge": {
      // palette.yellow.400 [overrides core #007acc] (match comments)
      "background": {
        "color": "palette.yellow.400"
      },
      // -color--gray-black [overrides core #ffffff]
      "foreground": {
        "color": "palette.gray.1000"
      }
    },
    "badge": {
      // -color--gray-dark-fade [overrides core #4d4d4d] | example: problems panel in title
      "background": {
        "color": "palette.gray.700"
      },
      // -color--gray-white [overrides core #ffffff]
      "foreground": {
        "color": "palette.gray.000"
      }
    },
    "button": {
      // Semantic fill at L53; see the documented token exception
      "background": {
        "color": "#1c6bc4",
        "reason": "Primary button fill uses L53/H255 with gamut headroom, allowing its lighter blue 600 hover state to retain at least 4.5:1 contrast with the button text."
      },
      // -color--gray-white [overrides core #ffffff]
      "foreground": {
        "color": "palette.gray.000"
      },
      // palette.blue.600 at L55; lighter than the semantic button fill
      "hoverBackground": {
        "color": "palette.blue.600"
      },
      // -color--gray-dark-fade [overrides core #3a3d41] | example: circle 'back to top' button on an extension page
      "secondaryBackground": {
        "color": "palette.gray.700"
      },
      // -color--gray-white [overrides core #ffffff at opacity]
      "secondaryForeground": {
        "color": "palette.gray.000"
      },
      // -color--oklch-gray-46 [overrides core #5c5c5c] (4 shades lighter than `button.secondaryBackground`)
      "secondaryHoverBackground": {
        "color": "palette.gray.650"
      }
    },
    "charts": {
      // palette.green.400 [overrides core green #89d185] | example: Incoming/Outgoing branch dot in source control sidebar
      "green": {
        "color": "palette.green.400"
      },
      // palette.orange.400 [overrides `minimap.findMatchHighlight`] | example: Incoming/Outgoing second dot in source control sidebar
      "orange": {
        "color": "palette.orange.400"
      },
      // palette.purple.400 [overrides core #b180d7] | example: Incoming/Outgoing second dot in source control sidebar
      "purple": {
        "color": "palette.purple.400"
      }
    },
    "debugIcon": {
      // palette.blue.400 [overrides core #75beff]
      "pauseForeground": {
        "color": "palette.blue.400"
      },
      // palette.green.400 [overrides core #89d185]
      "restartForeground": {
        "color": "palette.green.400"
      },
      // palette.green.400[overrides core #89d185]
      "startForeground": {
        "color": "palette.green.400"
      },
      // palette.red.400 [overrides core #f48771]
      "stopForeground": {
        "color": "palette.red.400"
      }
    },
    "debugToolBar": {
      // -color--gray-fade [overrides core #333333]
      "background": {
        "color": "palette.gray.800"
      }
    },
    "diffEditor": {
      // -color--gray-dark-fade [overrides core #464646]
      "diagonalFill": {
        "color": "palette.gray.700"
      },
      // palette.green.400 at 10% opacity [overrides core green opacity]
      "insertedLineBackground": {
        "color": "diff.added.foreground",
        "alpha": 0.10196078431372549
      },
      // palette.green.400 at 20% opacity [overrides core green opacity]
      "insertedTextBackground": {
        "color": "diff.added.foreground",
        "alpha": 0.2
      },
      // palette.red.400 at 10% opacity [overrides core red opacity]
      "removedLineBackground": {
        "color": "diff.removed.foreground",
        "alpha": 0.10196078431372549
      },
      // palette.red.400 at 20% opacity [overrides core red opacity]
      "removedTextBackground": {
        "color": "diff.removed.foreground",
        "alpha": 0.2
      },
      // palette.blue.400 at 5% opacity [overrides core black with opacity] | example: previewing a file that is in the Incoming/Outgoing list in the source control sidebar
      "unchangedCodeBackground": {
        "color": "palette.blue.400",
        "alpha": 0.050980392156862744
      },
      // palette.blue.400 at 5% opacity [overrides `sideBar.background`] | example: previewing a file that is in the Incoming/Outgoing list in the source control sidebar
      "unchangedRegionBackground": {
        "color": "palette.blue.400",
        "alpha": 0.050980392156862744
      },
      // -color--gray-medium [overrides `foreground`] (match `icon.foreground`) | example: previewing a file that is in the Incoming/Outgoing list in the source control sidebar
      "unchangedRegionForeground": {
        "color": "palette.gray.400"
      },
      // -color--black at 20% opacity [overrides core black with opacity] (match `widget.shadow`) | example: previewing a file that is in the Incoming/Outgoing list in the source control sidebar
      "unchangedRegionShadow": {
        "color": "palette.gray.black",
        "alpha": 0.2
      }
    },
    "diffEditorGutter": {
      // palette.green.400 at 10% opacity [base]
      "insertedLineBackground": {
        "color": "diff.added.foreground",
        "alpha": 0.10196078431372549
      },
      // palette.red.400 at 10% opacity [base]
      "removedLineBackground": {
        "color": "diff.removed.foreground",
        "alpha": 0.10196078431372549
      }
    },
    // -color--white at 20% opacity [overrides core white at opacity]
    "disabledForeground": {
      "color": "palette.gray.white",
      "alpha": 0.2
    },
    "dropdown": {
      // -color--gray-fade [overrides core #3c3c3c] (match `input.background`) | example: output panel tasks selection
      "background": {
        "color": "palette.gray.800"
      },
      // -color--gray-dark-fade [base] (match `input.border`)
      "border": {
        "color": "palette.gray.700"
      },
      // -color--gray-white [overrides core #efefef] (match `foreground`)
      "foreground": {
        "color": "palette.gray.200"
      },
      // -color--oklch-32-gray (2 shades darker than dropdown.background) [overrides `dropdown.background`] | example: settings UI page dropdowns
      "listBackground": {
        "color": "palette.gray.825"
      }
    },
    "editor": {
      // -color--gray-fade-black [overrides core #1e1e1e]
      "background": {
        "color": "surface.editor"
      },
      // palette.purple.600 at 90% opacity [overrides dimmed core blue #515c6a] | example: active search match
      "findMatchBackground": {
        "color": "palette.purple.600",
        "alpha": 0.9019607843137255
      },
      // palette.purple.500 at 90% opacity | example: inactive search match
      "findMatchForeground": {
        "color": "palette.purple.500",
        "alpha": 0.9019607843137255
      },
      // palette.purple.600 at 45% opacity [overrides core orange at opacity #653618] | example: inactive search match
      "findMatchHighlightBackground": {
        "color": "palette.purple.600",
        "alpha": 0.45098039215686275
      },
      // -color--white at 90% opacity [overrides `editor.findMatchForeground`] | example: active search match
      "findMatchHighlightForeground": {
        "color": "palette.gray.white",
        "alpha": 0.9019607843137255
      },
      // -color--white at 10% opacity [overrides core dimmed gray #2d2e30] | example: background when using finder widget with selection search only
      "findRangeHighlightBackground": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549
      },
      // palette.blue.400 at 15% opacity [overrides dimmed `editor.selectionBackground`]
      "foldBackground": {
        "color": "palette.blue.400",
        "alpha": 0.14901960784313725
      },
      // -color--gray-medium [overrides core #808080] | example: dots at end of line that has been folded // wait to see if the core is set by any other settings first
      "foldPlaceholderForeground": {
        "color": "palette.gray.400"
      },
      // -color--gray-light [overrides core #bbbbbb] (match `foreground`) | example: extension page text, empty editor text
      "foreground": {
        "color": "text.default"
      },
      // -color--white at 10% opacity [overrides core #252f39] | example: hover over a word in json object
      "hoverHighlightBackground": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549
      },
      // -color--oklch-20-gray [base] (6 shades darker than editor bg)
      "lineHighlightBackground": {
        "color": "palette.gray.975"
      },
      // -color--oklch-20-gray [overrides core #282828] (match editor.lineHighlightBackground)
      "lineHighlightBorder": {
        "color": "palette.gray.975"
      },
      // -color--white at 10% opacity [overrides dimmed `editor.findRangeHighlightBackground`] (match `editor.findRangeHighlightBackground`) | example: current search match line
      "rangeHighlightBackground": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549
      },
      // palette.blue.600 at 50% opacity [overrides core blue opacity #264f78]
      "selectionBackground": {
        "color": "palette.blue.600",
        "alpha": 0.5019607843137255
      },
      // -gray-medium-dark at 50% opacity [overrides core #483f4d] | example: click in word and all the matches are colored
      "wordHighlightBackground": {
        "color": "palette.gray.500",
        "alpha": 0.5019607843137255
      },
      // palette.pink.400 at 40% opacity [overrides core #063b58] | example: click on a class in a css file (Note: minimap uses `minimap.selectionOccurrenceHighlight` which is a different color)
      "wordHighlightStrongBackground": {
        "color": "palette.pink.400",
        "alpha": 0.4
      }
    },
    "editorBracketMatch": {
      // -color--gray-dark [overrides core #888888]
      "border": {
        "color": "palette.gray.600"
      }
    },
    "editorCodeLens": {
      // palette.yellow.500 [overrides core #929292] | example: debug arrow and text in editor
      "foreground": {
        "color": "palette.yellow.500"
      }
    },
    "editorCursor": {
      // -color--gray-fade [overrides core #555456] | example: text inside cursor block
      "background": {
        "color": "palette.gray.800"
      },
      // --color--gray-medium [overrides core #aeafad] | example: cursor block and current line highlight in overviewRuler
      "foreground": {
        "color": "palette.gray.400"
      }
    },
    "editorError": {
      // palette.red.500 [overrides core red #ee4f47] | examples: squiggly underlines and panel error icon
      "foreground": {
        "color": "diagnostic.error.foreground"
      }
    },
    "editorGhostText": {
      // palette.blue.500 | example: includes sidebar source control input placeholder text
      "foreground": {
        "color": "palette.blue.500"
      }
    },
    "editorGroup": {
      // -color--black at 50% opacity [overrides core #444444] | example: split editor border
      "border": {
        "color": "palette.gray.black",
        "alpha": 0.5019607843137255
      },
      // -color--gray-medium at 50% opacity [overrides core gray at opacity]
      "dropBackground": {
        "color": "palette.gray.400",
        "alpha": 0.5019607843137255
      }
    },
    "editorGroupHeader": {
      // -color--oklch-30-gray (2 shades lighter than sidebar bg) [overrides core #252526]
      "tabsBackground": {
        "color": "palette.gray.850"
      }
    },
    "editorGutter": {
      // palette.green.400 at 75% opacity [overrides core green #487e02] | example: scrollbar and number line bar diff
      "addedBackground": {
        "color": "palette.green.400",
        "alpha": 0.7490196078431373
      },
      // -color--gray-fade [overrides`list.inactiveSelectionBackground`] | example: next and plus buttons for git changes... foreground is controlled by `icon.foreground`
      "commentRangeForeground": {
        "color": "palette.gray.800"
      },
      // palette.red.400 at 75% opacity [overrides core #f85149] | includes overviewRuler
      "deletedBackground": {
        "color": "palette.red.400",
        "alpha": 0.7490196078431373
      },
      // palette.yellow.400 at 75% opacity [overrides core #1b81a8]
      "modifiedBackground": {
        "color": "palette.yellow.400",
        "alpha": 0.7490196078431373
      }
    },
    "editorHint": {
      // palette.blue.400 [overrides core #949494] | example: 3 dots underline
      "foreground": {
        "color": "palette.blue.400"
      }
    },
    "editorIndentGuide": {
      // -color--gray-dark-fade [overrides `editorWhitespace.foreground`]
      "activeBackground1": {
        "color": "palette.gray.700"
      }
    },
    "editorInfo": {
      // palette.blue.400 [overrides core #3275c3] | example: info squiggly underlines and panel info icon
      "foreground": {
        "color": "palette.blue.400"
      }
    },
    "editorLightBulb": {
      // palette.yellow.500 [overrides core #ffcc00]
      "foreground": {
        "color": "palette.yellow.500"
      }
    },
    "editorLightBulbAi": {
      // palette.yellow.500 [overrides core #ffcc00] | example: double star icon
      "foreground": {
        "color": "palette.yellow.500"
      }
    },
    "editorLightBulbAutoFix": {
      // palette.blue.400 [overrides core #75beff] | example: quick fix icon when clicking in a misspelled JS variable declaration
      "foreground": {
        "color": "palette.blue.400"
      }
    },
    "editorLineNumber": {
      // -color--gray-light [override core gray #c6c6c6]
      "activeForeground": {
        "color": "palette.gray.200"
      },
      // -color--gray-dark [override core #858585]
      "foreground": {
        "color": "palette.gray.600"
      }
    },
    "editorLink": {
      // palette.yellow.400 [overrides core #4e94ce] | example: activating link in comments
      "activeForeground": {
        "color": "palette.yellow.400"
      }
    },
    "editorOverviewRuler": {
      // [overrides dimmed `editorGutter.addedBackground`]
      "addedForeground": {
        "color": "palette.green.400",
        "alpha": 0.7490196078431373
      },
      // -color--black at 10% opacity [overrides `editor.background`]
      "background": {
        "color": "palette.gray.black",
        "alpha": 0.10196078431372549
      },
      // -color--black at 10% opacity [overrides core #323232] (match `editorOverviewRuler.background`)
      "border": {
        "color": "palette.gray.black",
        "alpha": 0.10196078431372549
      },
      // -color--gray-dark at 75% opacity [overrides core #a0a0a0] (match `editorBracketMatch.border` with opacity)
      "bracketMatchForeground": {
        "color": "palette.gray.600",
        "alpha": 0.7490196078431373
      },
      // palette.red.400 at 75% opacity [overrides dimmed `editorGutter.deletedBackground`]
      "deletedForeground": {
        "color": "palette.red.400",
        "alpha": 0.7490196078431373
      },
      // palette.red.500 at 75% opacity [overrides core #bd1717]
      "errorForeground": {
        "color": "palette.red.500",
        "alpha": 0.7490196078431373
      },
      // palette.purple.600 at 75% opacity [overrides core dimmed orange #77531c]
      "findMatchForeground": {
        "color": "palette.purple.600",
        "alpha": 0.7490196078431373
      },
      // palette.blue.400 at 75% opacity [overrides `editorInfo.foreground`]
      "infoForeground": {
        "color": "palette.blue.400",
        "alpha": 0.7490196078431373
      },
      // palette.yellow.400 at 75% opacity [overrides dimmed `editorGutter.modifiedBackground`]
      "modifiedForeground": {
        "color": "palette.yellow.400",
        "alpha": 0.7490196078431373
      },
      // -color--gray-medium-dark at 75% of 50% opacity = 37.5% (round to 38% opacity) [overrides core #86808a] | example: click in word and all the matches are colored (match `editor.wordHighlightBackground`)
      "selectionHighlightForeground": {
        "color": "palette.gray.500",
        "alpha": 0.3803921568627451
      },
      // palette.orange.400 at 75% opacity [overrides `editorWarning.foreground`]
      "warningForeground": {
        "color": "palette.orange.400",
        "alpha": 0.7490196078431373
      },
      // -color--gray-medium-dark at 75% of 50% opacity = 37.5% (round to 38% opacity) [overrides core #868686] (match `editorOverviewRuler.selectionHighlightForeground`) | example: click on a recurring property in a css file
      "wordHighlightForeground": {
        "color": "palette.gray.500",
        "alpha": 0.3803921568627451
      },
      // palette.pink.400 at 75% opacity[overrides core purple at opacity #a086a0] (match `editor.wordHighlightStrongBackground`) | example: click on a class in a css file... any defining element such as a JS function or variable definition
      "wordHighlightStrongForeground": {
        "color": "palette.pink.400",
        "alpha": 0.7490196078431373
      }
    },
    "editorRuler": {
      // palette.orange.400 at 10% opacity [overrides core #5a5a5a] | example: char width guideline
      "foreground": {
        "color": "palette.orange.400",
        "alpha": 0.10196078431372549
      }
    },
    "editorStickyScroll": {
      // [overrides 'editor.background'] (2 shades lighter than 'editor.background')
      "background": {
        "color": "palette.gray.875"
      }
    },
    "editorStickyScrollHover": {
      // [overrides core #2a2d2e] (match `editor.lineHighlightBackground`)
      "background": {
        "color": "palette.gray.975"
      }
    },
    "editorUnicodeHighlight": {
      // palette.orange.400 at 25% opacity [base]
      "background": {
        "color": "palette.orange.400",
        "alpha": 0.25098039215686274
      },
      // palette.orange.400 at 50% opacity [overrides `editorWarning.foreground`]
      "border": {
        "color": "palette.orange.400",
        "alpha": 0.5019607843137255
      }
    },
    "editorWarning": {
      // palette.orange.400 [overrides core yellow #cca700] | example: warning squiggly underlines and panel warning icon
      "foreground": {
        "color": "diagnostic.warning.foreground"
      }
    },
    "editorWhitespace": {
      // -color--gray-fade [overrides core #424342]
      "foreground": {
        "color": "palette.gray.800"
      }
    },
    "editorWidget": {
      // -color--oklch-32-gray [overrides core #252526] | example: finder widget or hover popup info
      "background": {
        "color": "palette.gray.825"
      },
      // -color--white at 10% opacity [overrides core #454545] | example: editor hover word popup widget
      "border": {
        "color": "palette.gray.white",
        "alpha": 0.10196078431372549
      }
    },
    // palette.red.500 [overrides core #ee4f47] | example: no results found in editor finder widget
    "errorForeground": {
      "color": "diagnostic.error.foreground"
    },
    "extensionIcon": {
      // palette.green.600 at 90% opacity [override core #1d9271] | example: GitLens extension in sidebar list
      "preReleaseForeground": {
        "color": "palette.green.600",
        "alpha": 0.9019607843137255
      },
      // palette.pink.600 at 90% opacity [overrides core #d758b3] | example: heart icon on Code Spell Checker extension page
      "sponsorForeground": {
        "color": "palette.pink.600",
        "alpha": 0.9019607843137255
      },
      // palette.orange.500 at 90% opacity [overrides core #ff8e00] | example: extension star ratings
      "starForeground": {
        "color": "palette.orange.500",
        "alpha": 0.9019607843137255
      }
    },
    // palette.blue.500 at 80% opacity [overrides core #0078d4] | example: active sidebar list item, active input border, active panel border
    "focusBorder": {
      "color": "palette.blue.500",
      "alpha": 0.8
    },
    // -color--gray-light [overrides core #cccccc] | examples: breadcrumbs, explorer sidebar, extension titles
    "foreground": {
      "color": "palette.gray.200"
    },
    "gitDecoration": {
      // palette.green.500 [overrides core green #72c890] | example: filename in tabs and sidebar for staged/committed file
      "addedResourceForeground": {
        "color": "palette.green.500"
      },
      // palette.red.500 [overrides core red] | example: hover over source control sidebar incoming/outgoing list item that has a commit deletion or filename in tabs and sidebar for staged/committed file
      "deletedResourceForeground": {
        "color": "palette.red.500"
      },
      // -color--oklch-gray-62 [overrides core #828282] | example: filename in tabs and sidebar
      "ignoredResourceForeground": {
        "color": "palette.gray.450"
      },
      // palette.yellow.400 [overrides core #e2c08d] | example: filename in tabs and sidebar of non-staged file
      "modifiedResourceForeground": {
        "color": "palette.yellow.400"
      },
      // palette.yellow.500 [overrides core yellow #e2c08d] | example: filename in tabs and sidebar for staged file
      "stageModifiedResourceForeground": {
        "color": "palette.yellow.500"
      },
      // palette.green.400 [overrides core #508d65] | example: filename in tabs and sidebar of non-staged file
      "untrackedResourceForeground": {
        "color": "palette.green.400"
      }
    },
    "icon": {
      // -color--gray-medium [overrides core #cccccc] | example: most UI icons in widgets (not selection button) (includes sidebar folder arrows)
      "foreground": {
        "color": "palette.gray.400"
      }
    },
    "input": {
      // -color--gray-fade [overrides core #3c3c3c]
      "background": {
        "color": "palette.gray.800"
      },
      // -color--gray-dark-fade [base] | example: input and debug console border
      "border": {
        "color": "palette.gray.700"
      },
      // -color--gray-white [overrides `foreground`]
      "foreground": {
        "color": "palette.gray.000"
      },
      // -color--gray-medium-dark [overrides dimmed `foreground`] (match comments color)
      "placeholderForeground": {
        "color": "palette.gray.500"
      }
    },
    "inputOption": {
      // palette.yellow.400 at 25% opacity [overrides core orange at opacity #85551f] | example: editor finder widget selection only button
      "activeBackground": {
        "color": "palette.yellow.400",
        "alpha": 0.25098039215686274
      },
      // palette.yellow.400 at 25% opacity [core overrides #007acc] | example: editor finder widget selection only button
      "activeBorder": {
        "color": "palette.yellow.400",
        "alpha": 0.25098039215686274
      },
      // palette.yellow.400 [overrides core #ffffff] | example: editor finder widget selection only button
      "activeForeground": {
        "color": "palette.yellow.400"
      },
      // palette.yellow.400 at 25% opacity [overrides core white at opacity] | example: sidebar global search exclude button
      "hoverBackground": {
        "color": "palette.yellow.400",
        "alpha": 0.25098039215686274
      }
    },
    "keybindingLabel": {
      // -color--gray-dark-fade [overrides core #343434]
      "background": {
        "color": "palette.gray.700"
      },
      // [overrides core #3d3d3d] (2 shades lighter than `keybindingLabel.background`)
      "border": {
        "color": "palette.gray.675"
      },
      // [overrides core #484848] (2 shades lighter than `keybindingLabel.border`)
      "bottomBorder": {
