{
  "class": {
    "for": "Semantic class symbols.",
    "inherits": [
      "scope:entity.name.type.class",
      "scope:support.class"
    ]
  },
  "function": {
    "for": "Semantic function symbols.",
    "inherits": [
      "scope:entity.name.function",
      "scope:support.function"
    ]
  },
  "function.defaultLibrary": {
    "for": "Semantic built-in function symbols.",
    "inherits": [
      "semantic.function",
      "scope:support.function"
    ]
  },
  "method": {
    "for": "Semantic method symbols.",
    "inherits": [
      "scope:entity.name.function.member",
      "scope:support.function"
    ]
  },
  "namespace": {
    "for": "Semantic namespace symbols.",
    "inherits": [
      "scope:entity.name.namespace"
    ]
  },
  "parameter": {
    "for": "Semantic parameter symbols.",
    "inherits": [
      "scope:variable.parameter"
    ]
  },
  "property": {
    "for": "Semantic property symbols.",
    "inherits": [
      "scope:variable.other.property"
    ]
  },
  "variable": {
    "for": "Semantic variable symbols.",
    "inherits": [
      "scope:variable.other.readwrite",
      "scope:entity.name.variable"
    ]
  },
  "variable.defaultLibrary": {
    "for": "Semantic built-in variable symbols.",
    "inherits": [
      "semantic.variable",
      "scope:support.variable",
      "scope:support.other.variable"
    ]
  }
}
