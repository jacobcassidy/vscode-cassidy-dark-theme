[
  //--------------------------------------------------------------------------
  //--- FONT STYLES ---
  //--------------------------------------------------------------------------
  {
    "name": "BOLD",
    "scope": [
      //*** MARKDOWN ***
      "markup.bold.markdown"
    ],
    "fontStyle": "bold"
  },
  {
    "name": "ITALIC",
    "scope": [
      //*** DEFAULT ***
      "comment",
      "invalid",
      "variable.language.this",
      //*** MARKDOWN ***
      "entity.name.section.markdown",
      "fenced_code.block.language.markdown",
      "markup.italic.markdown",
      //*** PHP ***
      "keyword.operator.return-value.php",
      "keyword.other.type.php",
      "meta.function.php punctuation.separator.inheritance.php" // function parameter and return typehint
      // "meta.function.php support.class.php" // function parameter and return typehint
    ],
    "fontStyle": "italic"
  },
  {
    "name": "BOLD ITALIC",
    "scope": [
      //*** MARKDOWN ***
      "markup.bold.markdown markup.italic.markdown"
    ],
    "fontStyle": "bold italic"
  },
  // {
  //   "name": "NORMAL",
  //   "scope": [],
  //   "fontStyle": ""
  // },
  {
    "name": "STRIKETHROUGH",
    "scope": [
      //*** MARKDOWN ***
      "markup.strikethrough.markdown"
    ],
    "fontStyle": "strikethrough"
  },

  //--------------------------------------------------------------------------
  //--- GRAY SHADES ---
  //--------------------------------------------------------------------------
  {
    "name": "GRAY WHITE (OKLCH 98%)",
    "scope": [
      //*** DEFAULT ***
      "meta.path.basename", // | example: when using global search results in editor instead of search panel
      "support.function",
      //*** APACHE ***
      "entity.helper.apacheconf", // Using Apache Conf extension for syntax grammar
      //*** CSS ***
      "entity.other.attribute-name.pseudo-class",
      "entity.other.attribute-name.pseudo-element",
      //*** HTML ***
      "text.html",
      "meta.element.structure.svg.text.html",
      //*** JS ***
      "meta.function-call.js entity.name.function.js", // example: some JS built-in methods
      //*** JSX ***
      "meta.jsx.children",
      //*** XML ***
      "text.xml"
    ],
    "color": "#f8f8f8",
    "colorReason": "Preserve GRAY WHITE (OKLCH 98%) foreground in the test comparison theme."
  },
  // {
  //   "name": "GRAY WHITE-LIGHT (OKLCH 90%)",
  //   "scope": [],
  //   "color": "#dedede",
  //   "colorReason": "Retain this unused syntax color for comparison."
  // },
  {
    "name": "GRAY WHITE-LIGHT-LIGHT (OKLCH 86%)",
    "scope": [
      //*** SHELL ***
      "meta.scope"
    ],
    "color": "#d1d1d1",
    "colorReason": "Preserve GRAY WHITE-LIGHT-LIGHT (OKLCH 86%) foreground in the test comparison theme."
  },
  {
    "name": "GRAY LIGHT (OKLCH 82%)",
    "scope": [
      //*** DEFAULT ***
      "meta.embedded.block", // Such as  ```shell text``` in markdown
      "meta.resultLinePrefix.matchLinePrefix.search meta", // match `editorLineNumber.activeForeground` | example: when using global search results in editor instead of search panel
      "support.constant.property", // semantic token type for JS
      //*** HTML ***
      "entity.other.attribute-name"
    ],
    "color": "#c4c4c4",
    "colorReason": "Preserve GRAY LIGHT (OKLCH 82%) foreground in the test comparison theme."
  },
  {
    "name": "GRAY LIGHT-MEDIUM (OKLCH 74%)",
    "scope": [
      "comment variable"
    ],
    "color": "#ababab",
    "colorReason": "Preserve GRAY LIGHT-MEDIUM (OKLCH 74%) foreground in the test comparison theme."
  },
  {
    "name": "GRAY MEDIUM (OKLCH 66%) [PUNCTUATION]",
    "scope": [
      //*** DEFAULT ***
      "comment storage.type punctuation",
      "comment storage.type", // | example: JSDoc @version
      "entity.name",
      "meta.at-rule.keyframes.body",
      "meta.block",
      "meta.brace",
      "meta.embedded.line",
      "meta.path.dirname.search", // -color--gray-medium | example: when using global search results in editor instead of search panel
      "punctuation",
      //*** CSS ***
      "meta.function.calc.css", // For nesting parentheses in calc function
      "meta.property-list",
      //*** MARKDOWN ***
      "fenced_code.block.language.markdown",
      "markup.strikethrough.markdown",
      "meta.separator.markdown",
      //*** PHP ***
      "comment keyword.operator.nullable-type.php", // example: ?array in docblock type hint
      "comment punctuation.separator.inheritance.php", // | example: PHPDoc: @var Gravity_Forms\Gravity_Forms\Save_Form\GF_Save_Form_Helper
      "comment support.other.namespace.php", // | example: PHPDoc: @var Gravity_Forms\Gravity_Forms\Save_Form\GF_Save_Form_Helper
      "keyword.operator.return-value.php", // For function return type colon
      "keyword.other.phpdoc.php", // The PHPDoc block keywords
      "meta.embedded.block.php", // For else colon when using alternative syntax
      "meta.embedded.line.php", // For closing bracket } when opening a new PHP tag
      "meta.function.parameter.default", // | example: the \ in a php: function get_home_url($blog_id = \null, $path = '', $scheme = \null) {}
      "meta.function.php punctuation.separator.inheritance.php", // function parameter and return typehint
      "string.quoted.double.php punctuation.definition.variable.php", // for {} braces syntax used in string interpolation.
      //*** RUBY ***
      "meta.function.method.with-arguments.ruby storage.type", // For Ruby's parameter block `&` operator
      //*** SHELL ***
      "meta.expression.assignment.modified.shell", //example `/` in .zshrc: export PATH=/opt/homebrew/bin:$PATH
      //*** SNIPPETS ***
      "custom.punctuation.separator.colon.json.comments.snippets", // example: `javascript.json` vscode snippets
      //*** XML ***
      "meta.tag",
      //*** ZSH ***
      "meta.parameter-expansion"
    ],
    "color": "#929292",
    "colorReason": "Preserve GRAY MEDIUM (OKLCH 66%) [PUNCTUATION] foreground in the test comparison theme."
  },
  {
    "name": "GRAY MEDIUM-DARK (OKLCH 58%) [COMMENTS]",
    "scope": [
      //*** DEFAULT ***
      "comment constant",
      "comment keyword",
      "comment meta.tag.inline",
      "comment punctuation",
      "comment storage.modifier",
      "comment storage",
      "comment support",
      "comment",
      "source.embedded",
      //*** MARKDOWN ***
      "markup.underline.link"
    ],
    "color": "#7a7a7a",
    "colorReason": "Preserve GRAY MEDIUM-DARK (OKLCH 58%) [COMMENTS] foreground in the test comparison theme."
  },
  {
    "name": "GRAY DARK (OKLCH 50%)",
    "scope": [
      //*** DEFAULT ***
      "invalid",
      "meta.resultLinePrefix.contextLinePrefix.search meta" // match `"editorLineNumber.foreground` | example: when using global search results in editor instead of search panel
    ],
    "color": "#636363",
    "colorReason": "Preserve GRAY DARK (OKLCH 50%) foreground in the test comparison theme."
  },
  // {
  //   "name": "GRAY DARK-FADE (OKLCH 42%)",
  //   "scope": [],
  //   "color": "#4d4d4d",
  //   "colorReason": "Retain this unused syntax color for comparison."
  // },
  // {
  //   "name": "GRAY FADE (OKLCH 34%)",
  //   "scope": [],
  //   "color": "#525252",
  //   "colorReason": "Retain this unused syntax color for comparison."
  // },

  //--------------------------------------------------------------------------
  //--- COLOR CUSTOMIZATIONS ---
  //--------------------------------------------------------------------------
  {
    "name": "BLUE BASE",
    "scope": [
      //*** DEFAULT ***
      "storage.type",
      //*** APACHE ***
      "string.path.apacheconf",
      //*** CSS ***
      "meta.attribute.unrecognized.xmlns.html string",
      "meta.attribute.unrecognized.xmlns:xlink.html string",
      "meta.function.url string.quoted.double", //css such as content: url("");
      "meta.function.url string.quoted.single", //css such as content: url('');
      //*** HTML ***
      "meta.attribute.href string",
      "meta.attribute.src.html string",
      "meta.attribute.srcset.html string",
      //*** LOG ***
      "log.date",
      //*** MARKDOWN ***
      "meta.link.reference",
      "meta.link.reference constant",
      "meta.link.reference string",
      "string.other.link.title.markdown",
      //*** SCSS ***
      "variable.parameter.url" // SCSS `to` in background: linear-gradient(to ...); -- Red in CSS. Also for background:url(../../../../assets/images/icons/icon-phone-white.svg) without quotes.
    ],
    "color": "#92c1fd",
    "colorReason": "-color--blue-base"
  },
  // {
  //   "name": "BLUE DEEP",
  //   "scope": [],
  //   "color": "#62a1f0",
  //   "colorReason": "Retain this unused syntax color for comparison."
  // },
  {
    "name": "BLUE FADE",
    "scope": [
      // DEFAULTS
      "comment entity.name.type", // example: 'Event' in JSdoc: @param {Event} name
      // "comment support.class", // example: PHPDoc  @return \PhpParser\Node[]
      //*** PHP - TYPEHINT ***
      "keyword.operator.nullable-type.php", // For nullable types using the question mark, such as ?callable
      "keyword.other.type.cassidydark.php", // class typehint
      "keyword.other.type.php", // For parameter type hinting and other types
      "meta.function.php storage.type.php", // ... : self
      // "meta.function.php support.class.php", // function parameter and return typehint
      "meta.other.type.phpdoc.php"
    ],
    "color": "#a9c0de",
    "colorReason": "Preserve BLUE FADE foreground in the test comparison theme."
  },
  {
    "name": "BLUE 50 OPACITY",
    "scope": [
      //*** MARKDOWN ***
      "markup.strikethrough.markdown string.other.link.title.markdown"
    ],
    "color": "#92c1fd80",
    "colorReason": "Preserve BLUE 50 OPACITY foreground in the test comparison theme."
  },

  {
    "name": "CYAN BASE",
    "scope": [
      //*** DEFAULT ***
      "entity.name.type", // such are class or trait name in PHP
      "entity.name.function",
      "keyword.other.special-method", // such as Ruby loop
      "meta.attribute.style string",
      "meta.property-name",
      "meta.property-value support.function",
      "support",
      //*** APACHE ***
      "entity.tag.apacheconf",
      //*** CSS ***
      "meta.at-rule support.function", // such as `calc` and `var`
      "meta.property-value",
      //*** INI ***
      "keyword.other.definition",
      //*** PHP ***
      "support.function.basic_functions",
      "entity.other.inherited-class.php", // extends class
      "entity.other.alias.php", // use as
      //*** PYTHON ***
      "meta.function-call.generic.python",
      //*** SHELL ***
      "support.function.builtin.shell",
      //*** YAML ***
      "entity.name.tag.yaml"
    ],
    "color": "#89dfdf",
    "colorReason": "Preserve CYAN BASE foreground in the test comparison theme."
  },

  {
    "name": "GREEN BASE",
    "scope": [
      //*** DEFAULT ***
      "entity.name.label", // property??
      "entity.other.attribute-name.class",
      "meta.attribute.class string",
      "meta.object-literal",
      "support.variable.property", // semantic token type
      "variable.other.constant.property", // semantic token type
      "variable.other.property",
      "variable.other.object.property",
      //*** APACHE ***
      "entity.mime-type.apacheconf",
      //*** MARKDOWN ***
      "entity.name.section.markdown",
      "markup.heading.markdown string.other.link.title.markdown",
      "markup.heading.markdown meta.other.valid-ampersand.markdown",
      "punctuation.definition.heading.markdown",
      //*** PHP ***
      "variable.other.property.php punctuation.definition.variable.php",
      //*** RUBY ***
      "constant.other.symbol.hashkey.ruby",
      "constant.other.symbol.ruby",
      //*** SHELL ***
      "entity.name.command",
      "entity.name.section.group-title", // example: [difftool "sourcetree"] in .gitconfig
      //*** SCSS ***
      "entity.other.attribute-name.parent-selector-suffix.css punctuation", // SCSS &__name
      //*** SNIPPETS ***
      "meta.insertion.placeholder.json.comments.snippets string" // example: `javascript.json` vscode snippets
    ],
    "color": "#a2cd8b",
    "colorReason": "Preserve GREEN BASE foreground in the test comparison theme."
  },

  {
    "name": "ORANGE BASE",
    "scope": [
      //*** DEFAULT ***
      "entity.other.attribute-name.id",
      "entity.other.attribute-name.id punctuation",
      "meta.attribute.id string",
      "variable.parameter",
      //*** APACHE ***
      "string.replacement.apacheconf",
      //*** CSS ***
      "entity.other.keyframe-offset",
      "meta.at-rule.keyframes",
      "support.constant.container-name.container.css", // For @container <container-name> (this token is from my CSS Nesting Syntax Highlighting extension)
      "variable.parameter.misc.css", // such as `content: counter(count, decimal);`
      //*** LOG ***
      "log.warning",
      //*** PHP ***
      "meta.function.parameters.php punctuation.definition.variable",
      "meta.function.parameters.php variable",
      "meta.function.parameters.php",
      "punctuation.section.embedded.begin.php",
      "punctuation.section.embedded.end.php",
      //*** SCSS ***
      "meta.at-rule.keyframes entity.name.function",
      "entity.other.attribute-name.scss",
      //*** SNIPPETS ***
      "custom.punctuation.section.insertion.dollar.simple.json.comments.snippets", // example: `javascript.json` vscode snippets
      "custom.punctuation.section.insertion.dollar.brackets.json.comments.snippets", // example: `javascript.json` vscode snippets
      "custom.punctuation.section.insertion.bracket.json.comments.snippets", // example: `javascript.json` vscode snippets
      "custom.variable.other.normal.numeric.json.comments.snippets" // example: `javascript.json` vscode snippets
    ],
    "color": "#eeae7b",
    "colorReason": "Preserve ORANGE BASE foreground in the test comparison theme."
  },

  {
    "name": "PINK BASE",
    "scope": [
      //*** DEFAULT ***
      "punctuation.definition.variable",
      "variable",
      //*** PHP ***
      "entity.name.variable.parameter.php", // -color--pink-base || example: "default" in: #[LanguageLevelTypeAware(['8.0' => 'CurlHandle|false'], default: 'resource|false')]
      "string.quoted.double.php variable.other.php punctuation.definition.variable.php", // for $ in string interpolation.
      //*** PYTHON ***
      "meta.function-call.arguments.python",
      //*** SHELL ***
      "variable.other.assignment.shell"
    ],
    "color": "#fcb7cb",
    "colorReason": "Preserve PINK BASE foreground in the test comparison theme."
  },

  {
    "name": "PURPLE BASE",
    "scope": [
      //*** DEFAULT ***
      "constant",
      "keyword.other.unit",
      "variable.language.this punctuation.definition.variable",
      "variable.language.this",
      //*** APACHE ***
      "entity.status.apacheconf",
      //*** CSS ***
      "support.constant.boolean.container.css", // for @container <style-query> boolean property-value (this token is from my CSS Nesting Syntax Highlighting extension)
      //*** HTML ***
      "constant punctuation.definition.entity", // HTML symbol entity
      "meta.attribute.async.html entity.other.attribute-name",
      "meta.attribute.crossorigin entity.other.attribute-name",
      "meta.attribute.defer.html entity.other.attribute-name",
      //*** INI ***
      "source.ini",
      //*** JAVASCRIPT ***
      "variable.other.constant.object.js",
      //*** PHP ***
      "entity.name.type.namespace.php", // namespace name
      //*** REGEX ***
      "meta.assertion.look-ahead.regexp",
      "meta.assertion.negative-look-ahead.regexp",
      "meta.group.regexp",
      "meta.group.assertion.regexp",
      "string.regexp",
      "string.regexp constant",
      "string.regexp keyword",
      "string.regexp punctuation",
      //*** SHELL ***
      "constant.other.option", //example: -i in shell
      "meta.arithmetic.shell", //example: $+functions[p10k]
      "keyword.operator.logical.shell", //example: `-f` in if [ -f "$ray_php"]
      "keyword.operator.expansion.shell", //example: ${tag//\%/%%}
      //*** XML ***
      "punctuation.definition.constant.xml"
    ],
    "color": "#d6aaea",
    "colorReason": "Preserve PURPLE BASE foreground in the test comparison theme."
  },
  {
    "name": "PURPLE DEEP",
    "scope": [
      //*** DEFAULT ***
      "entity.other.attribute-name.namespace",
      //*** PHP ***
      "entity.name.type.namespace.php",
      "keyword.other.class", // example: 'class' in self::class for PHP"
      "meta.function-call.php", // slash prepending constants
      "meta.method-call.php", // slash prepending constants
      "punctuation.separator.inheritance.php", // for namespaces
      "support.other.namespace.php"
    ],
    "color": "#bd84d7",
    "colorReason": "Preserve PURPLE DEEP foreground in the test comparison theme."
  },

  {
    "name": "RED BASE",
    "scope": [
      //*** DEFAULT ***
      "entity.name.tag",
      "keyword",
      "storage.modifier",
      //*** LOG ***
      "log.error",
      //*** PHP ***
      "entity.name.goto-label.php", // For 'else' using alternative colon syntax
      //*** SHELL ***
      "punctuation.separator.statement.and.shell" //example: &&
    ],
    "color": "#ef9182",
    "colorReason": "Preserve RED BASE foreground in the test comparison theme."
  },
  {
    "name": "RED DEEP",
    "scope": [
      //*** DEFAULT ***
    ],
    "color": "#db6656",
    "colorReason": "Preserve RED DEEP foreground in the test comparison theme."
  },

  {
    "name": "YELLOW BASE",
    "scope": [
      //*** DEFAULT ***
      "string",
      //*** CSS ***
      "meta.attribute-selector entity.other.attribute-name",
      //*** MARKDOWN ***
      "string.other.link.description.markdown",
      //*** PHP ***
      "string.quoted.single.php", // Override for "meta.attribute.src.html string"
      "string.quoted.double.php", // Override for "meta.attribute.src.html string"
      //*** SCSS ***
      "meta.attribute-selector.scss",
      //*** SNIPPETS ***
      "string meta.any.json.comments.snippets", // example: `javascript.json` vscode snippets
      //*** XML ***
      "meta.tag.sgml.doctype.xml"
    ],
    "color": "#efddac",
    "colorReason": "Preserve YELLOW BASE foreground in the test comparison theme."
  },
  {
    "name": "YELLOW DEEP",
    "scope": [
      //*** MARKDOWN ***
      "markup.inline.raw.string.markdown"
    ],
    "color": "#d7bb70",
    "colorReason": "Preserve YELLOW DEEP foreground in the test comparison theme."
  },

  //--------------------------------------------------------------------------
  // Better DockerFile Syntax - Extension
  // https://marketplace.visualstudio.com/items?itemName=jeff-hykin.better-dockerfile-syntax
  //--------------------------------------------------------------------------
  {
    "name": "[DOCKERFILE] - GRAY WHITE",
    "scope": [
      "source.dockerfile string"
    ],
    "color": "#f8f8f8",
    "colorReason": "Preserve [DOCKERFILE] - GRAY WHITE foreground in the test comparison theme."
  },
  {
    "name": "[DOCKERFILE] - CYAN BASE",
    "scope": [
      "source.dockerfile keyword.other.special-method"
    ],
    "color": "#89dfdf",
    "colorReason": "Preserve [DOCKERFILE] - CYAN BASE foreground in the test comparison theme."
  },
  {
    "name": "[DOCKERFILE] - GREEN BASE",
    "scope": [
      "source.dockerfile entity.name"
    ],
    "color": "#a2cd8b",
    "colorReason": "Preserve [DOCKERFILE] - GREEN BASE foreground in the test comparison theme."
  },
  {
    "name": "[DOCKERFILE] - ORANGE BASE",
    "scope": [
      "source.dockerfile constant.other.option"
    ],
    "color": "#eeae7b",
    "colorReason": "Preserve [DOCKERFILE] - ORANGE BASE foreground in the test comparison theme."
  },
  {
    "name": "[DOCKERFILE] - RED BASE",
    "scope": [
      "punctuation.separator.statement.and.shell.dockerfile"
    ],
    "color": "#ef9182",
    "colorReason": "Preserve [DOCKERFILE] - RED BASE foreground in the test comparison theme."
  },

  //--------------------------------------------------------------------------
  // Nginx.conf - (Syntax) Extension
  // https://marketplace.visualstudio.com/items?itemName=shanoor.vscode-nginx
  //--------------------------------------------------------------------------
  {
    "name": "[NGINX] - GRAY LIGHT (OKLCH 82%)",
    "scope": [
      "source.nginx"
    ],
    "color": "#c4c4c4",
    "colorReason": "Preserve [NGINX] - GRAY LIGHT (OKLCH 82%) foreground in the test comparison theme."
  },
  {
    "name": "GRAY MEDIUM (OKLCH 66%) [PUNCTUATION]",
    "scope": [
      "source.nginx constant.character"
    ],
    "color": "#929292",
    "colorReason": "Preserve GRAY MEDIUM (OKLCH 66%) [PUNCTUATION] foreground in the test comparison theme."
  },

  {
    "name": "[NGINX] - BLUE BASE",
    "scope": [
      "source.nginx constant.language.module"
    ],
    "color": "#92c1fd",
    "colorReason": "Preserve [NGINX] - BLUE BASE foreground in the test comparison theme."
  },
  {
    "name": "[NGINX] - CYAN BASE",
    "scope": [
      "source.nginx constant.language"
    ],
    "color": "#89dfdf",
    "colorReason": "Preserve [NGINX] - CYAN BASE foreground in the test comparison theme."
  },
  {
    "name": "[NGINX] - RED BASE",
    "scope": [
      "source.nginx constant.language.directive.module.main"
    ],
    "color": "#ef9182",
    "colorReason": "Preserve [NGINX] - RED BASE foreground in the test comparison theme."
  },

  //--------------------------------------------------------------------------
  // Output Colorizer - Extension
  // https://marketplace.visualstudio.com/items?itemName=IBM.output-colorizer
  //--------------------------------------------------------------------------
  {
    "name": "GRAY WHITE (OKLCH 98%)",
    "scope": [
      "code.log support" // For "Output Colorizer" extension
    ],
    "color": "#f8f8f8",
    "colorReason": "Preserve GRAY WHITE (OKLCH 98%) foreground in the test comparison theme."
  },

  {
    "name": "RED BASE",
    "scope": [
      "code.log invalid"
    ],
    "color": "#ef9182",
    "colorReason": "Preserve RED BASE foreground in the test comparison theme."
  },

  //--------------------------------------------------------------------------
  // Rainbow CSV - Extension
  // https://marketplace.visualstudio.com/items?itemName=mechatroner.rainbow-csv
  //--------------------------------------------------------------------------
  {
    "name": "NORMAL",
    "scope": [
      "comment.rainbow4",
      "invalid.rainbow10"
    ],
    "fontStyle": ""
  },
  {
    "name": "GRAY WHITE (OKLCH 98%)",
    "scope": [
      "markup.bold.rainbow9"
    ],
    "color": "#f8f8f8",
    "colorReason": "Preserve GRAY WHITE (OKLCH 98%) foreground in the test comparison theme."
  },
  {
    "name": "GRAY LIGHT (OKLCH 82%)",
    "scope": [
      "comment.rainbow4"
    ],
    "color": "#c4c4c4",
    "colorReason": "Preserve GRAY LIGHT (OKLCH 82%) foreground in the test comparison theme."
  },

  {
    "name": "BLUE BASE",
    "scope": [
      "constant.numeric.rainbow7"
    ],
    "color": "#92c1fd",
    "colorReason": "Preserve BLUE BASE foreground in the test comparison theme."
  },
  {
    "name": "CYAN BASE",
    "scope": [
      "rainbow1"
    ],
    "color": "#89dfdf",
    "colorReason": "Preserve CYAN BASE foreground in the test comparison theme."
  },
  {
    "name": "GREEN BASE",
    "scope": [
      "string.rainbow5"
    ],
    "color": "#a2cd8b",
    "colorReason": "Preserve GREEN BASE foreground in the test comparison theme."
  },
  {
    "name": "ORANGE BASE",
    "scope": [
      "variable.parameter.rainbow6"
    ],
    "color": "#eeae7b",
    "colorReason": "Preserve ORANGE BASE foreground in the test comparison theme."
  },
  {
    "name": "PINK BASE",
    "scope": [
      "entity.name.type.rainbow8"
    ],
    "color": "#fcb7cb",
    "colorReason": "Preserve PINK BASE foreground in the test comparison theme."
  },
  {
    "name": "PURPLE BASE",
    "scope": [
      "entity.name.function.rainbow3"
    ],
    "color": "#d6aaea",
    "colorReason": "Preserve PURPLE BASE foreground in the test comparison theme."
  },
  {
