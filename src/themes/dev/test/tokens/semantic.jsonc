{
  "builtinConstant": {
    "foreground": "#d6aaea" // -color--purple-base | example: Python boolean value
  },
  "class": {
    "foreground": "#89dfdf" // -color--cyan-base
  },
  "class.builtin": {
    "foreground": "#f8f8f8" // Such as python's str()
  },
  "function": {
    "foreground": "#89dfdf" // -color--cyan-base
  },
  "function.builtin": {
    "foreground": "#f8f8f8" // -color--gray-white || example: Python's str()
  },
  "function.defaultLibrary": {
    "foreground": "#f8f8f8" // -color--gray-white
  },
  "keyword": {
    "foreground": "#ef9182" // -color--red-base || example: Python's match keyword
  },
  "method": {
    "foreground": "#f8f8f8" // -color--gray-white
  },
  "namespace": {
    "foreground": "#d6aaea" // -color--purple-base
  },
  "parameter": {
    "foreground": "#eeae7b" // -color--orange-base
  },
  "property": {
    "foreground": "#a2cd8b" // -color--green-base
  },
  "variable": {
    "foreground": "#fcb7cb" // -color--pink-base
  },
  "variable.defaultLibrary": {
    "foreground": "#d1d1d1" // -color--gray-white-light-2
  }
}
