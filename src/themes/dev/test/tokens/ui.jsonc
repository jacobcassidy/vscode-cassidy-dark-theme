    "color": "#62a1f0",
    "colorReason": "-color--blue-deep [overrides core gray #464646] | example: Terminal gutter icon when starting Run Build Task"
  }, // -color--blue-deep [overrides core gray #464646] | example: Terminal gutter icon when starting Run Build Task
  "terminalCommandDecoration.errorBackground": {
    "color": "#db6656",
    "colorReason": "-color--red-deep"
  }, // -color--red-deep
  "terminalCommandDecoration.successBackground": {
    "color": "#79b158",
    "colorReason": "-color--green-deep [overrides core #1b81a8] | example: Run Build Task success message"
  }, // -color--green-deep [overrides core #1b81a8] | example: Run Build Task success message
  "terminalCommandGuide.foreground": {
    "color": "#ffffff40",
    "colorReason": "-color-white at 25% opacity [base] | example: Run Build Task terminal command guide text left border when hovering over the text"
  }, // -color-white at 25% opacity [base] | example: Run Build Task terminal command guide text left border when hovering over the text
  "terminalOverviewRuler.border": {
    "color": "#242424",
    "colorReason": "[overrides `editorOverviewRuler.border`] (match `terminal.background`)"
  }, // [overrides `editorOverviewRuler.border`] (match `terminal.background`)
  "terminalOverviewRuler.cursorForeground": {
    "color": "#929292",
    "colorReason": "--color--gray-medium [overrides core #878787] (match `editorCursor.foreground`) | example: current line match when using terminal search widget"
  }, // --color--gray-medium [overrides core #878787] (match `editorCursor.foreground`) | example: current line match when using terminal search widget
  "textBlockQuote.background": {
    "color": "#383838",
    "colorReason": "-color--gray-fade [overrides core #222222] | example: markdown > quote in preview mode"
  }, // -color--gray-fade [overrides core #222222] | example: markdown > quote in preview mode
  "textBlockQuote.border": {
    "color": "#636363",
    "colorReason": "-color--gray-dark [overrides core #1c5982]"
  }, // -color--gray-dark [overrides core #1c5982]
  "textCodeBlock.background": {
    "color": "#ffffff26",
    "colorReason": "-color--gray-fade [overrides core black at opacity] | example: hover over settings json \"workbench.startupEditor\" or hover over source control sidebar incoming/outgoing list item that has a commit using a codeblock"
  }, // -color--gray-fade [overrides core black at opacity] | example: hover over settings json "workbench.startupEditor" or hover over source control sidebar incoming/outgoing list item that has a commit using a codeblock
  "textLink.activeForeground": {
    "color": "#efddac",
    "colorReason": "-color--yellow-base [overrides core underlined #3794ff]"
  }, // -color--yellow-base [overrides core underlined #3794ff]
  "textLink.foreground": {
    "color": "#92c1fd",
    "colorReason": "-color--blue-base [overrides core #3794ff] | example: Settings UI text link or inline chat text link"
  }, // -color--blue-base [overrides core #3794ff] | example: Settings UI text link or inline chat text link
  "textPreformat.background": {
    "color": "#383838",
    "colorReason": "-color--gray-fade [overrides core #353535]"
  }, // -color--gray-fade [overrides core #353535]
  "textPreformat.foreground": {
    "color": "#d7bb70",
    "colorReason": "-color--yellow-deep [overrides core #d7ba7d]"
  }, // -color--yellow-deep [overrides core #d7ba7d]
  "titleBar.activeBackground": {
    "color": "#383838",
    "colorReason": "-color--gray-fade [override core ##3c3c3c] (match `statusBar.background`)"
  }, // -color--gray-fade [override core ##3c3c3c] (match `statusBar.background`)
  "titleBar.activeForeground": {
    "color": "#929292",
    "colorReason": "-color--gray-medium [overrides core #cccccc] | example: all text and icons in title bar (match `statusBar.foreground`)"
  }, // -color--gray-medium [overrides core #cccccc] | example: all text and icons in title bar (match `statusBar.foreground`)
  "titleBar.border": {
    "color": "#ffffff08",
    "colorReason": "-color-white at 3% opacity [base]"
  }, // -color-white at 3% opacity [base]
  "titleBar.inactiveBackground": {
    "color": "#2e2e2e",
    "colorReason": "-color--oklch-30-gray [overrides dimmed `titleBar.activeBackground`] (match `editorGroupHeader.tabsBackground`)"
  }, // -color--oklch-30-gray [overrides dimmed `titleBar.activeBackground`] (match `editorGroupHeader.tabsBackground`)
  "titleBar.inactiveForeground": {
    "color": "#636363",
    "colorReason": "-color--gray-fade [overrides dimmed `titleBar.activeForeground`]"
  }, // -color--gray-fade [overrides dimmed `titleBar.activeForeground`]
  "toolbar.hoverBackground": {
    "color": "#ffffff1a",
    "colorReason": "-color--gray-white at 10% opacity [overrides core white at opacity] | example: Settings UI gear icons"
  }, // -color--gray-white at 10% opacity [overrides core white at opacity] | example: Settings UI gear icons
  "tree.indentGuidesStroke": {
    "color": "#383838",
    "colorReason": "-color--gray-fade [overrides core #585858] | example: sidebar explorer tree"
  }, // -color--gray-fade [overrides core #585858] | example: sidebar explorer tree
  "tree.tableColumnsBorder": {
    "color": "#ffffff1a",
    "colorReason": "-color--white at 10% opacity [overrides core white at opacity] | example: Keyboard Shortcuts page"
  }, // -color--white at 10% opacity [overrides core white at opacity] | example: Keyboard Shortcuts page
  "tree.tableOddRowsBackground": {
    "color": "#2e2e2e",
    "colorReason": "-color--oklch-30 [overrides core #2b2b2b] (2 shades darker than `editor.background`) | example: Keyboard Shortcuts page"
  }, // -color--oklch-30 [overrides core #2b2b2b] (2 shades darker than `editor.background`) | example: Keyboard Shortcuts page
  "walkthrough.stepTitle.foreground": {
    "color": "#f8f8f8",
    "colorReason": "-color--gray-white [overrides core #ffffff] | example: clicking on a title on the welcome page takes you to the walkthrough page."
  }, // -color--gray-white [overrides core #ffffff] | example: clicking on a title on the welcome page takes you to the walkthrough page.
  "welcomePage.progress.background": {
    "color": "#333333",
    "colorReason": "[overrides `input.background`] | example: inactive part of progress bar"
  }, // [overrides `input.background`] | example: inactive part of progress bar
  "welcomePage.progress.foreground": {
    "color": "#a2cd8b",
    "colorReason": "-color--green-base [overrides `textLink.foreground`]"
  }, // -color--green-base [overrides `textLink.foreground`]
  "widget.border": {
    "color": "#ffffff0d",
    "colorReason": "-color--white at 5% opacity [base]"
  }, // -color--white at 5% opacity [base]
  "widget.shadow": {
    "color": "#00000033",
    "colorReason": "-color--black at 20% opacity | non-editor widgets [overrides core black at opacity]"
  } // -color--black at 20% opacity | non-editor widgets [overrides core black at opacity]
