    "textBlockQuote.border": "#f0f", //  --color--grayscale-600 [overrides core #1c5982]
    "textCodeBlock.background": "#ff00ff99", // --color--grayscale-800 [overrides core black at opacity] | example: hover over settings json "workbench.startupEditor" or hover over source control sidebar incoming/outgoing list item that has a commit using a codeblock
    "textLink.activeForeground": "#f0f", // --color--yellow-400 [overrides core underlined #3794ff]
    "textLink.foreground": "#f0f", // --color--blue-400 [overrides core #3794ff] | example: Settings UI text link
    "textPreformat.background": "#f0f", // --color--grayscale-800 [overrides core #353535]
    "textPreformat.border": "#f0f",
    "textPreformat.foreground": "#f0f", // --color--yellow-500 [overrides core #d7ba7d]
    "textSeparator.foreground": "#f0f",
    "titleBar.activeBackground": "#f0f", // --color--grayscale-800 [override core ##3c3c3c] (match `statusBar.background`)
    "titleBar.activeForeground": "#f0f", // --color--grayscale-400 [overrides core #cccccc] | example: all text and icons in title bar (match `statusBar.foreground`)
    "titleBar.border": "#f0f", // unneeded [base]
    "titleBar.inactiveBackground": "#f0f", // --color--grayscale-850 [overrides dimmed `titleBar.activeBackground`] (match `editorGroupHeader.tabsBackground`)
    "titleBar.inactiveForeground": "#f0f", // --color--grayscale-800 [overrides dimmed `titleBar.activeForeground`]
    "toolbar.activeBackground": "#ff00ff99", // [inherits`toolbar.hoverBackground` with opacity] | example: Settings UI gear icons when clicking/holding on it
    "toolbar.hoverBackground": "#ff00ff99", // --color--grayscale-000 at 10% opacity [overrides core white at opacity] | example: Settings UI gear icons
    "toolbar.hoverOutline": "#f0f", // unneeded [base]
    "tree.inactiveIndentGuidesStroke": "#f0f", // [inherits dimmed `tree.indentGuidesStroke`] | example: hover over inactive indent guides in sidebar
    "tree.indentGuidesStroke": "#f0f", // --color--grayscale-700 [overrides core #585858] | example: sidebar explorer tree
    "tree.tableColumnsBorder": "#ff00ff99", // --color--pure-white at 10% opacity [overrides core white at opacity] | example: Keyboard Shortcuts page
    "tree.tableOddRowsBackground": "#f0f", // --color--grayscale-850 [overrides core #2b2b2b] (2 shades darker than `editor.background`) | example: Keyboard Shortcuts page
    "walkThrough.embeddedEditorBackground": "#f0f",
    "walkthrough.stepTitle.foreground": "#f0f", // --color--grayscale-000 [overrides core #ffffff] | example: clicking on a title on the welcome page takes you to the walkthrough page.
    "welcomePage.background": "#f0f", // [inherits `editor.background`]
    "welcomePage.progress.background": "#f0f", // [overrides `input.background`] | example: inactive part of progress bar
    "welcomePage.progress.foreground": "#f0f", //  --color--green-400 [overrides `textLink.foreground`]
    "welcomePage.tileBackground": "#f0f", // [inherits `editorWidget.background`] | example: Walkthrough tiles on Welcome page
    "welcomePage.tileBorder": "#f0f", // [inherits `welcomePage.tileBackground` at opacity] | example: on a walkthrough page
    "welcomePage.tileHoverBackground": "#f0f", // [inherits lighten `editorWidget.background`] | example: hover over Walkthroughs tiles
    "widget.border": "#ff00ff99", // --color--pure-white at 5% opacity [base]
    "widget.shadow": "#ff00ff99", //  --color--pure-black at 20% opacity | non-editor widgets [overrides core black at opacity]
    "window.activeBorder": "#f0f", // unneeded [base]
    "window.inactiveBorder": "#f0f", // unneeded [base]

