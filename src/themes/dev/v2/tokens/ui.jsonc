    "scmGraph.historyItemGroupBase": "#00f", // [inherits `charts.orange`] | example: color of commits if from a different branch from the current one in the sidebar source control graph
    "scmGraph.historyItemGroupLocal": "#00f", // [inherits `charts.blue` || `editorInfo.foreground`] | example: Incoming/Outgoing dot in source control sidebar
    "scmGraph.historyItemGroupRemote": "#00f", // [inherits `charts.purple`] | example: Incoming/Outgoing dot in source control sidebar
