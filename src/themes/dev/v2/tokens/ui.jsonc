    "scm.historyGraph.historyItemGroupRemote": "#00f", // [inherits `charts.purple"` || core #b180d7] | example: Incoming/Outgoing second dot in source control sidebar
    "scm.historyGraph.red": "#00f",
    "scm.historyGraph.yellow": "#00f",
    "scm.historyItemAdditionsForeground": "#00f",
