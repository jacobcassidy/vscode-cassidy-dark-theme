    "minimap.selectionOccurrenceHighlight": "{ui.minimap.selectionOccurrenceHighlight}",
    "minimap.warningHighlight": "{ui.minimap.warningHighlight}",
    "multiDiffEditor.headerBackground": "{ui.multiDiffEditor.headerBackground}",
    "notebook.cellBorderColor": "{ui.notebook.cellBorderColor}",
    "outputViewStickyScroll.background": "{ui.outputViewStickyScroll.background}",
    "panel.background": "{ui.panel.background}",
    "panel.border": "{ui.panel.border}",
    "panel.dropBorder": "{ui.panel.dropBorder}",
