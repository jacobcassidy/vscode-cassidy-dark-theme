    "pickerGroup.border": "{ui.pickerGroup.border}",
    "pickerGroup.foreground": "{ui.pickerGroup.foreground}",
    "profileBadge.background": "{ui.profileBadge.background}",
    "profileBadge.foreground": "{ui.profileBadge.foreground}",
    "progressBar.background": "{ui.progressBar.background}",
    "quickInputTitle.background": "{ui.quickInputTitle.background}",
    "scrollbar.shadow": "{ui.scrollbar.shadow}",
    "scrollbarSlider.activeBackground": "{ui.scrollbarSlider.activeBackground}",
    "scrollbarSlider.background": "{ui.scrollbarSlider.background}",
    "scrollbarSlider.hoverBackground": "{ui.scrollbarSlider.hoverBackground}",
    "selection.background": "{ui.selection.background}",
    "settings.focusedRowBorder": "{ui.settings.focusedRowBorder}",
    "settings.headerForeground": "{ui.settings.headerForeground}",
    "settings.modifiedItemIndicator": "{ui.settings.modifiedItemIndicator}",
    "sideBar.background": "{ui.sideBar.background}",
    "sideBarSectionHeader.background": "{ui.sideBarSectionHeader.background}",
    "sideBarSectionHeader.foreground": "{ui.sideBarSectionHeader.foreground}",
    "sideBarStickyScroll.background": "{ui.sideBarStickyScroll.background}",
    "sideBarTitle.foreground": "{ui.sideBarTitle.foreground}",
    "simpleFindWidget.sashBorder": "{ui.simpleFindWidget.sashBorder}",
    "statusBar.background": "{ui.statusBar.background}",
    "statusBar.debuggingBackground": "{ui.statusBar.debuggingBackground}",
    "statusBar.debuggingForeground": "{ui.statusBar.debuggingForeground}",
    "statusBar.focusBorder": "{ui.statusBar.focusBorder}",
    "statusBar.foreground": "{ui.statusBar.foreground}",
    "statusBar.noFolderBackground": "{ui.statusBar.noFolderBackground}",
    "statusBar.noFolderForeground": "{ui.statusBar.noFolderForeground}",
    "statusBarItem.focusBorder": "{ui.statusBarItem.focusBorder}",
    "statusBarItem.hoverForeground": "{ui.statusBarItem.hoverForeground}",
    "statusBarItem.remoteBackground": "{ui.statusBarItem.remoteBackground}",
    "statusBarItem.remoteForeground": "{ui.statusBarItem.remoteForeground}",
    "statusBarItem.remoteHoverBackground": "{ui.statusBarItem.remoteHoverBackground}",
    "statusBarItem.remoteHoverForeground": "{ui.statusBarItem.remoteHoverForeground}",
    "symbolIcon.classForeground": "{ui.symbolIcon.classForeground}",
    "symbolIcon.functionForeground": "{ui.symbolIcon.functionForeground}",
    "symbolIcon.variableForeground": "{ui.symbolIcon.variableForeground}",
    "tab.activeForeground": "{ui.tab.activeForeground}",
    "tab.border": "{ui.tab.border}",
    "tab.dragAndDropBorder": "{ui.tab.dragAndDropBorder}",
    "tab.hoverForeground": "{ui.tab.hoverForeground}",
    "tab.inactiveBackground": "{ui.tab.inactiveBackground}",
    "tab.inactiveForeground": "{ui.tab.inactiveForeground}",
    "tab.unfocusedActiveForeground": "{ui.tab.unfocusedActiveForeground}",
    "tab.unfocusedHoverForeground": "{ui.tab.unfocusedHoverForeground}",
    "tab.unfocusedInactiveForeground": "{ui.tab.unfocusedInactiveForeground}",
    "terminal.ansiBlack": "{ui.terminal.ansiBlack}",
    "terminal.ansiBlue": "{ui.terminal.ansiBlue}",
    "terminal.ansiBrightBlack": "{ui.terminal.ansiBrightBlack}",
    "terminal.ansiBrightBlue": "{ui.terminal.ansiBrightBlue}",
    "terminal.ansiBrightCyan": "{ui.terminal.ansiBrightCyan}",
    "terminal.ansiBrightGreen": "{ui.terminal.ansiBrightGreen}",
    "terminal.ansiBrightMagenta": "{ui.terminal.ansiBrightMagenta}",
    "terminal.ansiBrightRed": "{ui.terminal.ansiBrightRed}",
    "terminal.ansiBrightWhite": "{ui.terminal.ansiBrightWhite}",
    "terminal.ansiBrightYellow": "{ui.terminal.ansiBrightYellow}",
    "terminal.ansiCyan": "{ui.terminal.ansiCyan}",
    "terminal.ansiGreen": "{ui.terminal.ansiGreen}",
    "terminal.ansiMagenta": "{ui.terminal.ansiMagenta}",
    "terminal.ansiRed": "{ui.terminal.ansiRed}",
    "terminal.ansiWhite": "{ui.terminal.ansiWhite}",
    "terminal.ansiYellow": "{ui.terminal.ansiYellow}",
    "terminal.background": "{ui.terminal.background}",
    "terminal.foreground": "{ui.terminal.foreground}",
    "terminalOverviewRuler.cursorForeground": "{ui.terminalOverviewRuler.cursorForeground}",
    "textBlockQuote.background": "{ui.textBlockQuote.background}",
    "textBlockQuote.border": "{ui.textBlockQuote.border}",
    "textCodeBlock.background": "{ui.textCodeBlock.background}",
    "textLink.activeForeground": "{ui.textLink.activeForeground}",
    "textLink.foreground": "{ui.textLink.foreground}",
    "textPreformat.background": "{ui.textPreformat.background}",
    "textPreformat.foreground": "{ui.textPreformat.foreground}",
    "titleBar.activeBackground": "{ui.titleBar.activeBackground}",
    "titleBar.activeForeground": "{ui.titleBar.activeForeground}",
    "titleBar.inactiveBackground": "{ui.titleBar.inactiveBackground}",
    "titleBar.inactiveForeground": "{ui.titleBar.inactiveForeground}",
    "toolbar.hoverBackground": "{ui.toolbar.hoverBackground}",
    "tree.indentGuidesStroke": "{ui.tree.indentGuidesStroke}",
    "tree.tableColumnsBorder": "{ui.tree.tableColumnsBorder}",
    "tree.tableOddRowsBackground": "{ui.tree.tableOddRowsBackground}",
    "walkthrough.stepTitle.foreground": "{ui.walkthrough.stepTitle.foreground}",
    "welcomePage.progress.background": "{ui.welcomePage.progress.background}",
    "welcomePage.progress.foreground": "{ui.welcomePage.progress.foreground}",
    "widget.border": "{ui.widget.border}",
    "widget.shadow": "{ui.widget.shadow}"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "{semantic.class}"
    },
    "function": {
      "foreground": "{semantic.function}"
    },
    "function.defaultLibrary": {
      "foreground": "{semantic.function.defaultLibrary}"
    },
    "method": {
      "foreground": "{semantic.method}"
    },
    "namespace": {
      "foreground": "{semantic.namespace}"
    },
    "parameter": {
      "foreground": "{semantic.parameter}"
    },
    "property": {
      "foreground": "{semantic.property}"
    },
    "variable": {
      "foreground": "{semantic.variable}"
    },
    "variable.defaultLibrary": {
      "foreground": "{semantic.variable.defaultLibrary}"
    }
  },
  "tokenColors": [
    //--------------------------------------------------------------------------
    //--- FONT STYLES ---
    //--------------------------------------------------------------------------
    {
      "name": "BOLD",
      "scope": [
        //*** MARKDOWN ***
        "markup.bold.markdown"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "ITALIC",
      "scope": [
        //*** DEFAULT ***
        "comment",
        "invalid",
        "variable.language.this",
        //*** MARKDOWN ***
        "entity.name.section.markdown",
        "markup.italic.markdown",
        //*** PHP ***
        "keyword.operator.return-value.php",
        "keyword.other.type.php",
        "meta.function.php support.class.php",
        //*** TYPESCRIPT ***
        "keyword.operator.type.annotation.ts",
        "support.type.primitive.ts"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "BOLD ITALIC",
      "scope": [
        //*** MARKDOWN ***
        "markup.bold.markdown markup.italic.markdown"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    },
    // {
    //   "name": "NORMAL",
    //   "scope": [],
    //   "settings": {
    //     "fontStyle": ""
    //   }
    // },
    {
      "name": "STRIKETHROUGH",
      "scope": [
        //*** MARKDOWN ***
        "markup.strikethrough.markdown"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },

    //--------------------------------------------------------------------------
    //--- GRAY SHADES ---
    //--------------------------------------------------------------------------
    {
      "name": "GRAY WHITE (OKLCH 98%)",
      "scope": [
        //*** DEFAULT ***
        "meta.method-call entity.name.function",
        "support.function",
        //*** APACHE ***
        "entity.helper.apacheconf", // Using Apache Conf extension for syntax grammar
        //*** CSS ***
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element",
        //*** HTML ***
        "text.html",
        "meta.element.structure.svg.text.html",
        //*** JSX ***
        "meta.jsx.children",
        //*** XML ***
        "text.xml"
      ],
      "settings": {
        "foreground": "{syntax.support}"
      }
    },
    // {
    //   "name": "GRAY WHITE-LIGHT (OKLCH 90%)",
    //   "scope": [],
    //   "settings": { "foreground": "#dedede" }
    // },
    {
      "name": "GRAY WHITE-LIGHT-LIGHT (OKLCH 86%)",
      "scope": [
        //*** JAVASCRIPT ***
        "variable.other.object", // semantic token type for JS
        //*** SHELL ***
        "meta.scope"
      ],
      "settings": {
        "foreground": "{syntax.defaultLibrary}"
      }
    },
    {
      "name": "GRAY LIGHT (OKLCH 82%)",
      "scope": [
        //*** DEFAULT ***
        "meta.embedded.block", // Such as  ```shell text``` in markdown
        "support.constant.property", // semantic token type for JS
        "support.variable", // semantic token type for JS
        //*** HTML ***
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "{syntax.text}"
      }
    },
    // {
    //   "name": "GRAY LIGHT-MEDIUM (OKLCH 74%)",
    //   "scope": [],
    //   "settings": {
    //     "foreground": "#ababab"
    //   }
    // },
    {
      "name": "GRAY MEDIUM (OKLCH 66%) [PUNCTUATION]",
      "scope": [
        //*** DEFAULT ***
        "entity.name",
        "meta.at-rule.keyframes.body",
        "meta.block",
        "meta.brace",
        "meta.embedded.line",
        "punctuation",
        //*** CSS ***
        "meta.function.calc.css", // For nesting parentheses in calc function
        "meta.property-list",
        //*** MARKDOWN ***
        "meta.separator.markdown",
        "markup.strikethrough.markdown",
        //*** PHP ***
        "comment keyword", // example: @package in PHPdoc comment
        "comment keyword.operator.nullable-type.php", // example: ?array in docblock type hint
        "comment support.class", // example: `editor` in @return editor in PHPdoc comment
        "keyword.other.phpdoc.php", // The PHPDoc block keywords
        "keyword.operator.return-value.php", // For function return type colon
        "meta.embedded.block.php", // For else colon when using alternative syntax
        "meta.embedded.line.php", // For closing bracket } when opening a new PHP tag
        "string.quoted.double.php punctuation.definition.variable.php", // for {} braces syntax used in string interpolation.
        //*** RUBY ***
        "meta.function.method.with-arguments.ruby storage.type", // For Ruby's parameter block `&` operator
        //*** SHELL ***
        "meta.expression.assignment.modified.shell", //example `/` in .zshrc: export PATH=/opt/homebrew/bin:$PATH
        //*** XML ***
        "meta.tag",
        //*** ZSH ***
        "meta.parameter-expansion"
      ],
      "settings": {
        "foreground": "{syntax.punctuation}"
      }
    },
    {
      "name": "GRAY MEDIUM-DARK (OKLCH 58%) [COMMENTS]",
      "scope": [
        //*** DEFAULT ***
        "comment",
        "comment constant",
        "comment entity.name.type",
        "comment keyword",
        "comment meta.tag.inline",
        "comment punctuation",
        "comment storage",
        "comment storage.modifier",
        "comment storage.type",
        "comment support",
        "comment variable",
        "punctuation.definition.comment",
        "source.embedded"
      ],
      "settings": {
        "foreground": "{syntax.comment}"
      }
    },
    {
      "name": "GRAY DARK (OKLCH 50%)",
      "scope": [
        //*** DEFAULT ***
        "invalid",
        //*** MARKDOWN ***
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "{syntax.invalid}"
      }
    },
    // {
    //   "name": "GRAY DARK-FADE (OKLCH 42%)",
    //   "scope": [],
    //   "settings": { "foreground": "#4d4d4d" }
    // },
    // {
    //   "name": "GRAY FADE (OKLCH 34%)",
    //   "scope": [],
    //   "settings": { "foreground": "#525252" }
    // },

    //--------------------------------------------------------------------------
    //--- COLOR CUSTOMIZATIONS ---
    //--------------------------------------------------------------------------
    {
      "name": "BLUE 400",
      "scope": [
        //*** DEFAULT ***
        "storage.type",
        //*** APACHE ***
        "string.path.apacheconf",
        //*** CSS ***
        "meta.attribute.unrecognized.xmlns.html string",
        "meta.attribute.unrecognized.xmlns:xlink.html string",
        "meta.function.url string.quoted.double", //css such as content: url("");
        "meta.function.url string.quoted.single", //css such as content: url('');
        //*** HTML ***
        "meta.attribute.href string",
        "meta.attribute.src.html string",
        "meta.attribute.srcset.html string",
        //*** LOG ***
        "log.date",
        //*** MARKDOWN ***
        "meta.link.reference",
        "meta.link.reference constant",
        "meta.link.reference string",
        "string.other.link.title.markdown",
        //*** SCSS ***
        "variable.parameter.url" // SCSS `to` in background: linear-gradient(to ...); -- Red in CSS. Also for background:url(../../../../assets/images/icons/icon-phone-white.svg) without quotes.
      ],
      "settings": {
        "foreground": "{syntax.storageType}"
      }
    },
    // {
    //   "name": "BLUE 500",
    //   "scope": [],
    //   "settings": { "foreground": "#62a1f0" }
    // },
    {
      "name": "BLUE 400-muted",
      "scope": [
        //*** PHP - TYPEHINT ***
        "keyword.other.type.php", // For parameter type hinting and other types
        "meta.other.type.phpdoc.php",
        "keyword.operator.nullable-type.php", // For nullable types using the question mark, such as ?callable
        // "keyword.other.type.cassidydark.php", // class typehint
        "meta.function.php storage.type.php", // ... : self
        "meta.function.php support.class.php", // ... : DB
        "meta.function.parameter.typehinted.php support", // ( \WP_Query $query )
        "meta.other.type.phpdoc.php support.class", // @param \WP_Post
        //*** TYPESCRIPT ***
        "keyword.operator.type.annotation.ts",
        "support.type.primitive.ts"
      ],
      "settings": {
        "foreground": "{syntax.typeHint}"
      }
    },
    {
      "name": "BLUE 400 AT 50% OPACITY",
      "scope": [
        //*** MARKDOWN ***
        "markup.strikethrough.markdown string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "{syntax.linkStrikethrough}"
      }
    },

    {
      "name": "CYAN 400",
      "scope": [
        //*** DEFAULT ***
        "entity.name.type", // such are class or trait name in PHP
        "entity.name.function",
        "keyword.other.special-method", // such as Ruby loop
        "meta.attribute.style string",
        "meta.property-name",
        "meta.property-value support.function",
        "support",
        //*** APACHE ***
        "entity.tag.apacheconf",
        //*** CSS ***
        "meta.at-rule support.function", // such as `calc` and `var`
        "meta.property-value",
        //*** INI ***
        "keyword.other.definition",
        //*** PHP ***
        "support.function.basic_functions",
        "entity.other.inherited-class.php", // extends class
        "entity.other.alias.php", // use as
        //*** PYTHON ***
        "meta.function-call.generic.python",
        //*** SHELL ***
        "support.function.builtin.shell",
        //*** YAML ***
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "{syntax.function}"
      }
    },

    {
      "name": "GREEN 400",
      "scope": [
        //*** DEFAULT ***
        "entity.name.label", // property??
        "entity.other.attribute-name.class",
        "meta.attribute.class string",
        "meta.object-literal",
        "support.variable.property", // semantic token type
        "variable.other.constant.property", // semantic token type
        "variable.other.property",
        "variable.other.object.property",
        //*** APACHE ***
        "entity.mime-type.apacheconf",
        //*** MARKDOWN ***
        "entity.name.section.markdown",
        "markup.heading.markdown string.other.link.title.markdown",
        "markup.heading.markdown meta.other.valid-ampersand.markdown",
        "punctuation.definition.heading.markdown",
        //*** PHP ***
        "variable.other.property.php punctuation.definition.variable.php",
        //*** RUBY ***
        "constant.other.symbol.hashkey.ruby",
        "constant.other.symbol.ruby",
        //*** SHELL ***
        "entity.name.command",
        "entity.name.section.group-title", // example: [difftool "sourcetree"] in .gitconfig
        //*** SCSS ***
        "entity.other.attribute-name.parent-selector-suffix.css punctuation" // SCSS &__name
      ],
      "settings": {
        "foreground": "{syntax.property}"
      }
    },

    {
      "name": "ORANGE 400",
      "scope": [
        //*** DEFAULT ***
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.id punctuation",
        "meta.attribute.id string",
        "variable.parameter",
        //*** APACHE ***
        "string.replacement.apacheconf",
        //*** CSS ***
        "entity.other.keyframe-offset",
        "meta.at-rule.keyframes",
        "support.constant.container-name.container.css", // For @container <container-name> (this token is from my CSS Nesting Syntax Highlighting extension)
        "variable.parameter.misc.css", // such as `content: counter(count, decimal);`
        //*** LOG ***
        "log.warning",
        //*** PHP ***
        "meta.function.parameters.php variable",
        "meta.function.parameters.php punctuation.definition.variable",
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.end.php",
        //*** SCSS ***
        "meta.at-rule.keyframes entity.name.function",
        "entity.other.attribute-name.scss"
      ],
      "settings": {
        "foreground": "{syntax.parameter}"
      }
    },

    {
      "name": "PINK 400",
      "scope": [
        //*** DEFAULT ***
        "punctuation.definition.variable",
        "variable",
        //*** PHP ***
        "string.quoted.double.php variable.other.php punctuation.definition.variable.php", // for $ in string interpolation.
        //*** PYTHON ***
        "meta.function-call.arguments.python",
        //*** SHELL ***
        "variable.other.assignment.shell"
      ],
      "settings": {
        "foreground": "{syntax.variable}"
      }
    },

    {
      "name": "PURPLE 400",
      "scope": [
        //*** DEFAULT ***
        "constant",
        "keyword.other.unit",
        //*** APACHE ***
        "entity.status.apacheconf",
        //*** CSS ***
        "support.constant.boolean.container.css", // for @container <style-query> boolean property-value (this token is from my CSS Nesting Syntax Highlighting extension)
        //*** HTML ***
        "constant punctuation.definition.entity", // HTML symbol entity
        "meta.attribute.async.html entity.other.attribute-name",
        "meta.attribute.crossorigin entity.other.attribute-name",
        "meta.attribute.defer.html entity.other.attribute-name",
        //*** INI ***
        "source.ini",
        //*** JAVASCRIPT ***
        "variable.other.constant.object.js",
        //*** PHP ***
        "entity.name.type.namespace.php", // namespace name
        //*** REGEX ***
        "meta.assertion.look-ahead.regexp",
        "meta.assertion.negative-look-ahead.regexp",
        "meta.group.regexp",
        "meta.group.assertion.regexp",
        "string.regexp",
        "string.regexp constant",
        "string.regexp keyword",
        "string.regexp punctuation",
        //*** SHELL ***
        "constant.other.option", //example: -i in shell
        "meta.arithmetic.shell", //example: $+functions[p10k]
        "keyword.operator.logical.shell", //example: `-f` in if [ -f "$ray_php"]
        "keyword.operator.expansion.shell", //example: ${tag//\%/%%}
        //*** XML ***
        "punctuation.definition.constant.xml"
      ],
      "settings": {
        "foreground": "{syntax.constant}"
      }
    },
    {
      "name": "PURPLE 500",
      "scope": [
        //*** DEFAULT ***
        "entity.other.attribute-name.namespace"
      ],
      "settings": {
        "foreground": "{syntax.attributeNamespace}"
      }
    },

    {
      "name": "RED 400",
      "scope": [
        //*** DEFAULT ***
        "entity.name.tag",
        "keyword",
        "storage.modifier",
        //*** LOG ***
        "log.error",
        //*** PHP ***
        "entity.name.goto-label.php", // For 'else' using alternative colon syntax
        //*** SHELL ***
        "punctuation.separator.statement.and.shell" //example: &&
      ],
      "settings": {
        "foreground": "{syntax.keyword}"
      }
    },
    {
      "name": "RED 500",
      "scope": [
        //*** DEFAULT ***
      ],
      "settings": {
        // "foreground": "#db6656",
      }
    },

    {
      "name": "YELLOW 400",
      "scope": [
        //*** DEFAULT ***
        "string",
        //*** CSS ***
        "meta.attribute-selector entity.other.attribute-name",
        //*** MARKDOWN ***
        "string.other.link.description.markdown",
        //*** PHP ***
        "string.quoted.single.php", // Override for "meta.attribute.src.html string"
        "string.quoted.double.php", // Override for "meta.attribute.src.html string"
        //*** SCSS ***
        "meta.attribute-selector.scss",
        //*** XML ***
        "meta.tag.sgml.doctype.xml"
      ],
      "settings": {
        "foreground": "{syntax.string}"
      }
    },
    {
      "name": "YELLOW 500",
      "scope": [
        //*** MARKDOWN ***
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "{syntax.code}"
      }
    },

    //--------------------------------------------------------------------------
    // Better DockerFile Syntax - Extension
    // https://marketplace.visualstudio.com/items?itemName=jeff-hykin.better-dockerfile-syntax
    //--------------------------------------------------------------------------
    {
      "name": "[DOCKERFILE] - GRAY WHITE",
      "scope": [
        "source.dockerfile string"
      ],
      "settings": {
        "foreground": "{syntax.support}"
      }
    },
    {
      "name": "[DOCKERFILE] - CYAN 400",
      "scope": [
        "source.dockerfile keyword.other.special-method"
      ],
      "settings": {
        "foreground": "{syntax.function}"
      }
    },
    {
      "name": "[DOCKERFILE] - GREEN 400",
      "scope": [
        "source.dockerfile entity.name"
      ],
      "settings": {
        "foreground": "{syntax.property}"
      }
    },
    {
      "name": "[DOCKERFILE] - ORANGE 400",
      "scope": [
        "source.dockerfile constant.other.option"
      ],
      "settings": {
        "foreground": "{syntax.parameter}"
      }
    },
    {
      "name": "[DOCKERFILE] - RED 400",
      "scope": [
        "punctuation.separator.statement.and.shell.dockerfile"
      ],
      "settings": {
        "foreground": "{syntax.keyword}"
      }
    },

    //--------------------------------------------------------------------------
    // Nginx.conf - (Syntax) Extension
    // https://marketplace.visualstudio.com/items?itemName=shanoor.vscode-nginx
    //--------------------------------------------------------------------------
    {
      "name": "[NGINX] - GRAY LIGHT (OKLCH 82%)",
      "scope": [
        "source.nginx"
      ],
      "settings": {
        "foreground": "{syntax.text}"
      }
    },
    {
      "name": "GRAY MEDIUM (OKLCH 66%) [PUNCTUATION]",
      "scope": [
        "source.nginx constant.character"
      ],
      "settings": {
        "foreground": "{syntax.punctuation}"
      }
    },

    {
      "name": "[NGINX] - BLUE 400",
      "scope": [
        "source.nginx constant.language.module"
      ],
      "settings": {
        "foreground": "{syntax.storageType}"
      }
    },
    {
      "name": "[NGINX] - CYAN 400",
      "scope": [
        "source.nginx constant.language"
      ],
      "settings": {
        "foreground": "{syntax.function}"
      }
    },
    {
      "name": "[NGINX] - RED 400",
      "scope": [
        "source.nginx constant.language.directive.module.main"
      ],
      "settings": {
        "foreground": "{syntax.keyword}"
      }
    },

    //--------------------------------------------------------------------------
    // Output Colorizer - Extension
    // https://marketplace.visualstudio.com/items?itemName=IBM.output-colorizer
    //--------------------------------------------------------------------------
    {
      "name": "GRAY WHITE (OKLCH 98%)",
      "scope": [
        "code.log support" // For "Output Colorizer" extension
      ],
      "settings": {
        "foreground": "{syntax.support}"
      }
    },

    {
      "name": "RED 400",
      "scope": [
        "code.log invalid"
      ],
      "settings": {
        "foreground": "{syntax.keyword}"
      }
    },

    //--------------------------------------------------------------------------
    // Rainbow CSV - Extension
    // https://marketplace.visualstudio.com/items?itemName=mechatroner.rainbow-csv
    //--------------------------------------------------------------------------
    {
      "name": "NORMAL",
      "scope": [
        "comment.rainbow4",
        "invalid.rainbow10"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "GRAY WHITE (OKLCH 98%)",
      "scope": [
        "markup.bold.rainbow9"
      ],
      "settings": {
        "foreground": "{syntax.support}"
      }
    },
    {
      "name": "GRAY LIGHT (OKLCH 82%)",
      "scope": [
        "comment.rainbow4"
      ],
      "settings": {
        "foreground": "{syntax.text}"
      }
    },

    {
      "name": "BLUE 400",
      "scope": [
        "constant.numeric.rainbow7"
      ],
      "settings": {
        "foreground": "{syntax.storageType}"
      }
    },
    {
      "name": "CYAN 400",
      "scope": [
        "rainbow1"
      ],
      "settings": {
        "foreground": "{syntax.function}"
      }
    },
    {
      "name": "GREEN 400",
      "scope": [
        "string.rainbow5"
      ],
      "settings": {
        "foreground": "{syntax.property}"
      }
    },
    {
      "name": "ORANGE 400",
      "scope": [
        "variable.parameter.rainbow6"
      ],
      "settings": {
        "foreground": "{syntax.parameter}"
      }
    },
    {
      "name": "PINK 400",
      "scope": [
        "entity.name.type.rainbow8"
      ],
      "settings": {
        "foreground": "{syntax.variable}"
      }
    },
    {
      "name": "PURPLE 400",
      "scope": [
        "entity.name.function.rainbow3"
      ],
      "settings": {
        "foreground": "{syntax.constant}"
      }
    },
    {
      "name": "RED 400",
      "scope": [
        "invalid.rainbow10"
      ],
      "settings": {
        "foreground": "{syntax.keyword}"
      }
    },
    {
      "name": "YELLOW 400",
      "scope": [
        "keyword.rainbow2"
      ],
      "settings": {
        "foreground": "{syntax.string}"
      }
    }
  ]
}
